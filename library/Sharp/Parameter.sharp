namespace Sharp;

import ReflectionAttribute;
import ReflectionParameter;
import Sharp.Internal.CreatesAttributes;

extern Internal.defaultValue uses none;

// A parameter of a method, as `Method.parameters()` gives it, spec section 25: its name, its type as declared, whether
// it is optional, which it is when a call may leave it out, whether it is variadic, whether it has a default that runs
// no code, and its default value. The engine creates it.
public class Parameter
{
    internal Parameter(
        private Class<Object> declaringClass,
        private string method,
        private int position,
        public string name { get; },
        public Class<Any?> type { get; },
        public bool isOptional { get; },
        public bool isVariadic { get; },
        public bool hasConstantDefault { get; }
    ) { }

    // Two values are one parameter when they are the same position of one method, so a `Map<Parameter, V>` keys by the
    // parameter whenever `parameters()` read it.
    public static bool operator ==(Parameter a, Parameter b)
        => a.declaringClass == b.declaringClass && a.method == b.method && a.position == b.position && a.name == b.name;

    public int hash() => global.crc32(`${this.declaringClass.name()}::${this.method}#${this.position}`);

    // The value a call that leaves the parameter out gives it, when `hasConstantDefault` holds. A default that runs
    // code, a `new`, a call or a lambda, throws `ValueError` and runs none of it, so a read is pure, spec section 29, and
    // a call that leaves the argument out runs the default under its own effects. A parameter with no default value, a
    // required or a variadic one, throws `OutOfRangeException`, as `List.first()` does when nothing matches.
    public Any? defaultValue() => Internal.defaultValue(this.declaringClass, this.method, this.position);

    // The attributes of the parameter of the class `TAttribute` or of a class that extends or implements it, as
    // `Class<T>.attributes()` gives a class's.
    [CreatesAttributes]
    public List<TAttribute> attributes<TAttribute : Object>()
        => this.reflected()
            .getAttributes(ClassMembers.declared(typeof(TAttribute)), ReflectionAttribute.IS_INSTANCEOF)
            .map(attribute => attribute.newInstance());

    // PHP's reflection of the parameter, through its method's, so a property accessor's `value` is reached as the
    // accessor is.
    private ReflectionParameter reflected()
        => ClassMembers.reflectedMethod(this.declaringClass, this.method).getParameters()[this.position]
            ?? throw new ValueError("The engine gave a parameter its method does not take.");
}
