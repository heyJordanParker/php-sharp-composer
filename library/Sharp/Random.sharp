namespace Sharp;

// Random values. A module binds `SystemRandom`, which is secure, and a test passes a seeded `Sharp.Testing.FakeRandom`.
public effect abstract class Random
{
    // min ≤ n < max, and min when they are equal.
    public abstract int nextInt(int min, int max);

    // 0.0 ≤ n < 1.0.
    public abstract float nextFloat();

    public abstract Bytes nextBytes(int length);

    // A new list in random order.
    public abstract List<T> shuffle<T>(List<T> items);

    // One random element, null for an empty list.
    public abstract T? pick<T>(List<T> items);
}
