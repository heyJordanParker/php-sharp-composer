namespace Sharp.Time;

import DateTimeImmutable;
import DateTimeZone;

// A region's rules for its clocks, named exactly as the IANA time zone database names it, such as "Europe/Sofia", or
// by one of its older names, such as "Europe/Kiev", or a fixed offset from UTC, such as "+03:00", as Java's ZoneId.of
// and Kotlin's TimeZone.of take them. The name is the zone's one field, so two zones of one name are `==`.
public struct TimeZone
{
    public TimeZone(public string name { get; })
    {
        if (!TimeZone.isName(name)) {
            throw new ValueError(global.in_array(name, global.timezone_identifiers_list(DateTimeZone.ALL_WITH_BC), true)
                ? `\`TimeZone\` takes a zone with the time zone database's rules, and PHP reads "${name}" as a fixed abbreviation without them. Name the region instead, such as "Europe/Brussels". \`TimeZone.tryOf\` gives null for it instead.`
                : `\`TimeZone\` takes a name from the time zone database, such as "Europe/Sofia", or an offset from -18:00 to +18:00, such as "+03:00", and "${name}" is neither. \`TimeZone.tryOf\` gives null for it instead.`);
        }
    }

    public static TimeZone utc => new TimeZone("UTC");

    // The database's current names, each one `TimeZone` takes.
    public static List<string> names() => global.array_values(global.timezone_identifiers_list()).filter((string name) => TimeZone.databaseNames.contains(name));

    public static TimeZone? tryOf(string name) => TimeZone.isName(name) ? new TimeZone(name) : null;

    // Whether `name` is a name of the database, or an offset written `+HH:MM` or `-HH:MM` within Java's ±18:00.
    private static bool isName(string name)
        => TimeZone.databaseNames.contains(name) || global.preg_match("/\\A[+-](?:(?:0[0-9]|1[0-7]):[0-5][0-9]|18:00)\\z/", name) == 1;

    // The offset of a zone whose clocks never change: "+03:00", "UTC" and
    // "Etc/GMT-3" each have one, and a zone the database gives any change of offset, as "Europe/Sofia", has none. PHP's
    // rules list each change, and none for a zone an offset names, which they give as false.
    public Duration? fixedOffset
        => this.rules().getTransitions() is List<Any> changes && changes.count() > 1 ? null : this.offsetAt(new Instant(0));

    // How far the zone's clocks are ahead of UTC at `instant`.
    public Duration offsetAt(Instant instant) => Duration.ofSeconds(this.rules().getOffset(DateTimeImmutable.createFromTimestamp(instant.epochSeconds)));

    public string toString() => this.name;

    // The instant the zone's clocks show `localSeconds`, counted from 1970-01-01T00:00:00 on those clocks, as Java's
    // ZonedDateTime.of resolves it: the earlier instant when the clocks show it twice, and the time the gap's length
    // later when they skip it.
    internal Instant instantAt(int localSeconds)
    {
        const before = this.offsetAt(new Instant(localSeconds - 86400)).seconds;
        const after = this.offsetAt(new Instant(localSeconds + 86400)).seconds;
        const early = Math.max(before, after);
        const late = Math.min(before, after);
        if (this.offsetAt(new Instant(localSeconds - early)).seconds == early) {
            return new Instant(localSeconds - early);
        }
        if (this.offsetAt(new Instant(localSeconds - late)).seconds == late) {
            return new Instant(localSeconds - late);
        }

        return new Instant(localSeconds - before);
    }

    // The database's rules for the zone, one `DateTimeZone` per name while the app runs, so a zone stores only its name.
    internal DateTimeZone rules()
    {
        if (TimeZone.rulesByName.get(this.name) is DateTimeZone kept) {
            return kept;
        }
        const made = new DateTimeZone(this.name);
        TimeZone.rulesByName[this.name] = made;

        return made;
    }

    private static Map<string, DateTimeZone> rulesByName = [:];

    // Every name of the database, its older names included, that PHP builds with the database's rules, read once while
    // the app runs. PHP's `DateTimeZone` also takes an offset, an abbreviation and any case of a name, so it can't check
    // one, and it reads some names of the database, as "CET", "GMT" and "EST", as a fixed abbreviation, whose rules
    // list no transitions, so "CET" would never change its clocks for summer. Checking all 598 names takes 0.6 to 1.9 ms
    // on PHP 8.5's release build, against 115 µs to read the list alone.
    private static Set<string> databaseNames = global.array_values(global.timezone_identifiers_list(DateTimeZone.ALL_WITH_BC))
        .filter((string name) => new DateTimeZone(name).getTransitions(0, 0) is List<Any>)
        .toSet();
}
