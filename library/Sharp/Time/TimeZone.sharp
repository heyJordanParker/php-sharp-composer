namespace Sharp.Time;

import DateTimeImmutable;
import DateTimeZone;

// A region's rules for its clocks, named exactly as the IANA time zone database names it, such as "Europe/Sofia", or
// by one of its older names, such as "Europe/Kiev", as Java's ZoneId.of takes them. The name is the zone's one field,
// so two zones of one name are `==`.
public struct TimeZone
{
    public TimeZone(public string name { get; })
    {
        if (!TimeZone.databaseNames.contains(name)) {
            throw new ValueError(`\`TimeZone\` takes a name from the time zone database, such as "Europe/Sofia", and "${name}" is not one. \`TimeZone.tryOf\` gives null for it instead.`);
        }
    }

    public static TimeZone utc => new TimeZone("UTC");

    public static List<string> names() => global.array_values(global.timezone_identifiers_list());

    public static TimeZone? tryOf(string name) => TimeZone.databaseNames.contains(name) ? new TimeZone(name) : null;

    // How far the zone's clocks are ahead of UTC at `instant`.
    public Duration offsetAt(Instant instant) => Duration.ofSeconds(this.rules().getOffset(DateTimeImmutable.createFromTimestamp(instant.epochSeconds)));

    public string toString() => this.name;

    // The instant the zone's clocks show `localSeconds`, counted from 1970-01-01T00:00:00 on those clocks, as Java's
    // ZonedDateTime.of resolves it: the earlier instant when the clocks show it twice, and the time the gap's length
    // later when they skip it.
    internal Instant instantAt(int localSeconds)
    {
        const before = this.offsetAt(new Instant(localSeconds - 86400)).seconds;
        const after = this.offsetAt(new Instant(localSeconds + 86400)).seconds;
        const early = Math.max(before, after);
        const late = Math.min(before, after);
        if (this.offsetAt(new Instant(localSeconds - early)).seconds == early) {
            return new Instant(localSeconds - early);
        }
        if (this.offsetAt(new Instant(localSeconds - late)).seconds == late) {
            return new Instant(localSeconds - late);
        }

        return new Instant(localSeconds - before);
    }

    // The database's rules for the zone, one `DateTimeZone` per name while the app runs, so a zone stores only its name.
    internal DateTimeZone rules()
    {
        if (TimeZone.rulesByName.get(this.name) is DateTimeZone kept) {
            return kept;
        }
        const made = new DateTimeZone(this.name);
        TimeZone.rulesByName[this.name] = made;

        return made;
    }

    private static Map<string, DateTimeZone> rulesByName = [:];

    // Every name the database has, its older names included, read once while the app runs, since a read takes about
    // 100 µs. PHP's `DateTimeZone` also takes an offset, an abbreviation and any case of a name, so it can't check one.
    private static Set<string> databaseNames = global.array_values(global.timezone_identifiers_list(DateTimeZone.ALL_WITH_BC)).toSet();
}
