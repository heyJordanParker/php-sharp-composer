namespace Sharp.Time;

// A day of the proleptic Gregorian calendar, with no time and no time zone, as Kotlin's LocalDate and .NET's DateOnly.
public struct Date
{
    public Date(public int year { get; }, public int month { get; }, public int day { get; })
    {
        if (month < 1 || month > 12 || day < 1 || day > Date.daysInMonth(year, month)) {
            throw new ValueError(`\`Date\` takes a day of the calendar, and ${year}-${month}-${day} is not one.`);
        }
    }

    // The day `days` after 1970-01-01, as Howard Hinnant's civil_from_days computes it.
    public static Date ofEpochDay(int days)
    {
        const shifted = days + 719_468;
        const era = shifted.floorDiv(146_097);
        const dayOfEra = shifted - era * 146_097;
        const yearOfEra = (dayOfEra - dayOfEra / 1_460 + dayOfEra / 36_524 - dayOfEra / 146_096) / 365;
        const dayOfYear = dayOfEra - (365 * yearOfEra + yearOfEra / 4 - yearOfEra / 100);
        const shiftedMonth = (5 * dayOfYear + 2) / 153;
        const month = shiftedMonth < 10 ? shiftedMonth + 3 : shiftedMonth - 9;

        return new Date(yearOfEra + era * 400 + (month <= 2 ? 1 : 0), month, dayOfYear - (153 * shiftedMonth + 2) / 5 + 1);
    }

    // The days since 1970-01-01.
    public int epochDay => Date.daysFromCivil(this.year, this.month, this.day);

    public Date plusDays(int days) => Date.ofEpochDay(this.epochDay + days);

    // The same day `months` later, or the month's last day when it is shorter, as Kotlin's and Java's plusMonths.
    public Date plusMonths(int months)
    {
        const index = this.year * 12 + this.month - 1 + months;
        const year = index.floorDiv(12);
        const month = index.mod(12) + 1;

        return new Date(year, month, Math.min(this.day, Date.daysInMonth(year, month)));
    }

    public int daysUntil(Date later) => later.epochDay - this.epochDay;

    public bool isBefore(Date other) => this.epochDay < other.epochDay;

    public bool isAfter(Date other) => this.epochDay > other.epochDay;

    // The first moment of the day in `zone`, which is later than midnight on a day whose clocks skip midnight.
    public DateTime atStartOfDay(TimeZone zone) => zone.instantAt(this.epochDay * 86400).inZone(zone);

    // ISO-8601, as "2026-10-22".
    public string toString()
    {
        const year = this.year < 0 ? global.sprintf("-%04d", -this.year) : this.year > 9999 ? `+${this.year}` : global.sprintf("%04d", this.year);

        return global.sprintf("%s-%02d-%02d", year, this.month, this.day);
    }

    public static Date parse(string text)
        => Date.tryParse(text) ?? throw new ValueError(`\`Date.parse\` reads an ISO-8601 day, such as "2026-10-22", and "${text}" is not.`);

    public static Date? tryParse(string text)
    {
        if (global.preg_match("/\\A[0-9]{4}-[0-9]{2}-[0-9]{2}\\z/", text) != 1) {
            return null;
        }
        const year = Int.parse(global.substr(text, 0, 4));
        const month = Int.parse(global.substr(text, 5, 2));
        const day = Int.parse(global.substr(text, 8, 2));

        return month >= 1 && month <= 12 && day >= 1 && day <= Date.daysInMonth(year, month) ? new Date(year, month, day) : null;
    }

    // Howard Hinnant's days_from_civil.
    private static int daysFromCivil(int year, int month, int day)
    {
        const shiftedYear = month <= 2 ? year - 1 : year;
        const era = shiftedYear.floorDiv(400);
        const yearOfEra = shiftedYear - era * 400;
        const dayOfYear = (153 * (month > 2 ? month - 3 : month + 9) + 2) / 5 + day - 1;

        return era * 146_097 + yearOfEra * 365 + yearOfEra / 4 - yearOfEra / 100 + dayOfYear - 719_468;
    }

    private static int daysInMonth(int year, int month)
        => month == 2
            ? (year % 4 == 0 && (year % 100 != 0 || year % 400 == 0) ? 29 : 28)
            : (month == 4 || month == 6 || month == 9 || month == 11 ? 30 : 31);
}
