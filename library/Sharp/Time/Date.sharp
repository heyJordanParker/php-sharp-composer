namespace Sharp.Time;

import DateTimeImmutable;
import DateTimeZone;

public static class Date
{
    public static string format(int timestamp, string pattern, string timeZone = "UTC")
        => new DateTimeImmutable(`@${timestamp}`).setTimezone(new DateTimeZone(timeZone)).format(pattern);

    public static int? parse(string text)
        => date_create_immutable(text, new DateTimeZone("UTC")) is DateTimeImmutable date ? date.getTimestamp() : null;
}
