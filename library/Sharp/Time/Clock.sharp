namespace Sharp.Time;

// The clock. A module binds `SystemClock`, the machine's, and a test passes a `Sharp.Testing.FakeClock`.
public effect abstract class Clock
{
    public abstract Instant now();

    // Monotonic nanoseconds, only for measuring.
    public abstract int timestamp();

    // The time since a `timestamp()`.
    public abstract Duration elapsedSince(int start);

    public abstract void sleep(Duration duration);
}
