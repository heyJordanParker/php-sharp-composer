namespace Sharp.Time;

// A point on the time line, in seconds and nanoseconds since 1970-01-01T00:00:00Z, as Kotlin's and Java's Instant.
public struct Instant
{
    public Instant(public int epochSeconds { get; }, public int nanosecond { get; } = 0)
    {
        if (nanosecond < 0 || nanosecond > 999_999_999) {
            throw new ValueError("`Instant` takes a nanosecond from 0 to 999999999, and it is outside that range.");
        }
    }

    public static Instant ofEpochMilliseconds(int milliseconds)
        => new Instant(milliseconds.floorDiv(1_000), milliseconds.mod(1_000) * 1_000_000);

    public int epochMilliseconds => this.epochSeconds * 1_000 + this.nanosecond / 1_000_000;

    public Instant plus(Duration duration)
    {
        const nanoseconds = this.nanosecond + duration.nanoseconds.mod(1_000_000_000);

        return new Instant(this.epochSeconds + duration.nanoseconds.floorDiv(1_000_000_000) + nanoseconds / 1_000_000_000, nanoseconds % 1_000_000_000);
    }

    public Instant minus(Duration duration) => this.plus(duration.negated());

    public Duration until(Instant later)
        => new Duration((later.epochSeconds - this.epochSeconds) * 1_000_000_000 + later.nanosecond - this.nanosecond);

    public bool isBefore(Instant other)
        => this.epochSeconds < other.epochSeconds || this.epochSeconds == other.epochSeconds && this.nanosecond < other.nanosecond;

    public bool isAfter(Instant other) => other.isBefore(this);

    public DateTime inZone(TimeZone zone) => new DateTime(this, zone);

    // ISO-8601 in UTC, as "2026-10-22T18:30:00Z", with the fraction of a second in groups of 3 digits when it has one.
    public string toString() => this.inZone(TimeZone.utc).localText() + "Z";

    public static Instant parse(string text)
        => Instant.tryParse(text) ?? throw new ValueError(`\`Instant.parse\` reads ISO-8601 with an offset, such as "2026-10-22T18:30:00Z", and "${text}" is not.`);

    // ISO-8601 with `Z` or an offset such as `+02:00`, and an optional fraction of a second of up to 9 digits.
    public static Instant? tryParse(string text)
    {
        Map<int|string, string> found = [:];
        const pattern = "/\\A([0-9]{4}-[0-9]{2}-[0-9]{2})T([01][0-9]|2[0-3]):([0-5][0-9]):([0-5][0-9])(?:\\.([0-9]{1,9}))?(?:Z|[+-](?:0[0-9]|1[0-8]):[0-5][0-9])\\z/";
        if (global.preg_match(pattern, text, found) != 1 || Date.tryParse(found[1] ?? "") is not Date date) {
            return null;
        }
        const seconds = Int.parse(found[2] ?? "") * 3600 + Int.parse(found[3] ?? "") * 60 + Int.parse(found[4] ?? "");

        return new Instant(date.epochDay * 86400 + seconds - Instant.offsetSeconds(text), Duration.fractionNanoseconds(found[5] ?? ""));
    }

    // The offset an ISO-8601 instant ends with, in seconds: 0 for `Z`, 7200 for `+02:00`.
    internal static int offsetSeconds(string text)
    {
        if (global.str_ends_with(text, "Z")) {
            return 0;
        }
        const seconds = Int.parse(global.substr(text, -5, 2)) * 3600 + Int.parse(global.substr(text, -2)) * 60;

        return global.substr(text, -6, 1) == "-" ? -seconds : seconds;
    }
}
