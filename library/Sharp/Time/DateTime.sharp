namespace Sharp.Time;

import DateTimeImmutable;

// An instant as the clocks of a time zone show it, as JavaScript's Temporal.ZonedDateTime and Java's ZonedDateTime.
public struct DateTime
{
    public DateTime(public Instant instant { get; }, public TimeZone zone { get; }) { }

    public Duration offset => this.zone.offsetAt(this.instant);

    public Date date => Date.ofEpochDay(this.localSeconds.floorDiv(86400));

    public int hour => this.localSeconds.mod(86400) / 3600;

    public int minute => this.localSeconds.mod(3600) / 60;

    public int second => this.localSeconds.mod(60);

    public int nanosecond => this.instant.nanosecond;

    public Weekday weekday => this.date.weekday;

    public Month monthOfYear => this.date.monthOfYear;

    public DateTime plus(Duration duration) => new DateTime(this.instant.plus(duration), this.zone);

    public DateTime minus(Duration duration) => new DateTime(this.instant.minus(duration), this.zone);

    public DateTime inZone(TimeZone zone) => new DateTime(this.instant, zone);

    // A plain PHP date at the same instant, in the zone, to the microsecond, as `Instant.toPhpDateTime` gives one.
    public DateTimeImmutable toPhpDateTime() => this.instant.toPhpDateTime().setTimezone(this.zone.rules());

    // By the instant, then by the zone's name, so it gives 0 exactly when `==` is true, as Java's ZonedDateTime.compareTo.
    public static int operator <=>(DateTime a, DateTime b)
        => a.instant == b.instant ? a.zone.name <=> b.zone.name : a.instant <=> b.instant;

    // ISO-8601 with the offset, then the zone's name, as RFC 9557 and Temporal write it: "2026-10-22T21:30:00+03:00[Europe/Sofia]".
    public string toString() => `${this.toOffsetString()}[${this.zone.name}]`;

    // ISO-8601 with the offset and no zone, as RFC 3339 and PHP's date("c") write it: "2026-10-22T21:30:00+03:00".
    public string toOffsetString() => `${this.localText()}${this.offsetText()}`;

    // The date and the time of day on the zone's clocks, as a SQL DATETIME column holds them: "2026-10-22 21:30:00".
    public string toSqlString() => this.clockText(" ");

    // The date and time of day `text` writes on the clocks of `zone`, with a space or a "T" between them, as a SQL
    // DATETIME column or an HTML datetime-local input gives them: "2026-10-22 21:30:00", "2026-10-22T21:30" or
    // "2026-10-22T21:30:00.250". A time the clocks show twice is the earlier instant, and one they skip is the time the
    // gap's length later, as Java's ZonedDateTime.of resolves them.
    public static DateTime parseLocal(string text, TimeZone zone)
        => DateTime.tryParseLocal(text, zone) ?? throw new ValueError(`\`DateTime.parseLocal\` reads a date and a time of day, such as "2026-10-22 21:30:00", and "${text}" is not.`);

    public static DateTime? tryParseLocal(string text, TimeZone zone)
    {
        Map<int|string, string> found = [:];
        const pattern = "/\\A([0-9]{4}-[0-9]{2}-[0-9]{2})[T ]([0-9]{2}):([0-9]{2})(?::([0-9]{2})(?:\\.([0-9]{1,9}))?)?\\z/";
        if (global.preg_match(pattern, text, found) != 1 || Date.tryParse(found[1] ?? "") is not Date date) {
            return null;
        }
        const hour = Int.parse(found[2] ?? "");
        const minute = Int.parse(found[3] ?? "");
        const second = (found[4] ?? "") == "" ? 0 : Int.parse(found[4] ?? "");
        if (hour > 23 || minute > 59 || second > 59) {
            return null;
        }
        const nanosecond = Duration.fractionNanoseconds(found[5] ?? "");
        const at = zone.instantAt(date.epochDay * 86400 + hour * 3600 + minute * 60 + second);

        return new DateTime(new Instant(at.epochSeconds, nanosecond), zone);
    }

    public static DateTime parse(string text)
        => DateTime.tryParse(text) ?? throw new ValueError(`\`DateTime.parse\` reads ISO-8601 with an offset and a zone, such as "2026-10-22T21:30:00+03:00[Europe/Sofia]", and "${text}" is not.`);

    // Null when the offset is not the zone's offset at that instant, as Temporal rejects it.
    public static DateTime? tryParse(string text)
    {
        if (global.strrpos(text, "[") is not int open || !global.str_ends_with(text, "]")) {
            return null;
        }
        const instantText = global.substr(text, 0, open);
        if (Instant.tryParse(instantText) is not Instant instant || TimeZone.tryOf(global.substr(text, open + 1, -1)) is not TimeZone zone) {
            return null;
        }
        const parsed = new DateTime(instant, zone);

        return parsed.offset.seconds == Instant.offsetSeconds(instantText) ? parsed : null;
    }

    // The date and the time of day, as "2026-10-22T21:30:00" or "2026-10-22T21:30:00.250".
    internal string localText() => `${this.clockText("T")}${Duration.fractionOf(this.nanosecond)}`;

    // The date, `between`, and the time of day to the second, from one read of the zone's clocks, since each read of
    // `offset` asks the zone's rules again.
    private string clockText(string between)
    {
        const seconds = this.localSeconds;
        const time = global.sprintf("%02d:%02d:%02d", seconds.mod(86400) / 3600, seconds.mod(3600) / 60, seconds.mod(60));

        return `${Date.ofEpochDay(seconds.floorDiv(86400)).toString()}${between}${time}`;
    }

    // The offset as ISO-8601 writes it, as "+03:00".
    private string offsetText()
    {
        const minutes = this.offset.minutes;

        return global.sprintf("%s%02d:%02d", minutes < 0 ? "-" : "+", minutes.abs() / 60, minutes.abs() % 60);
    }

    private int localSeconds => this.instant.epochSeconds + this.offset.seconds;
}
