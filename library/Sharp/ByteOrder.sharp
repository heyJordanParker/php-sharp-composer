namespace Sharp;

// The order an `int`'s bytes are written in, as Java's ByteOrder and Rust's to_be_bytes and to_le_bytes. Each case's
// value is the letter of PHP's `pack` that writes 8 bytes in that order, which `int.toBytes` runs on.
public enum ByteOrder : string
{
    // The most significant byte first, as networks write numbers.
    case Big = "J";
    // The least significant byte first, as x86 and ARM processors keep numbers.
    case Little = "P";
}
