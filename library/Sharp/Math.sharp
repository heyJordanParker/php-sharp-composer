namespace Sharp;

import Sharp.Internal.LeanFunction;

public static class Math
{
    public const float PI = global.M_PI;

    public const float E = global.M_E;

    public static float sqrt(float x) => global.sqrt(x);

    // A logarithm of a negative number is NaN, and of 0 is negative infinity, as Kotlin's and Rust's are.
    public static float log(float x) => global.log(x);

    public static float log10(float x) => global.log10(x);

    public static float exp(float x) => global.exp(x);

    // The trigonometric functions take and give radians, and asin and acos give NaN outside -1 to 1.
    public static float sin(float x) => global.sin(x);

    public static float cos(float x) => global.cos(x);

    public static float tan(float x) => global.tan(x);

    public static float asin(float x) => global.asin(x);

    public static float acos(float x) => global.acos(x);

    public static float atan(float x) => global.atan(x);

    // The angle of the point (x, y) from the positive x axis, from -PI to PI, as Kotlin's atan2(y, x).
    public static float atan2(float y, float x) => global.atan2(y, x);

    public static float pow(float base, float exponent)
        => base == 0.0 && exponent < 0.0
            ? throw new DivisionByZeroError("Math.pow: a base of 0 with a negative exponent divides by zero")
            : base ** exponent;

    [LeanFunction("max")]
    public static int max(int first, int ...rest) => global.max([first, ...rest]);

    [LeanFunction("min")]
    public static int min(int first, int ...rest) => global.min([first, ...rest]);
}
