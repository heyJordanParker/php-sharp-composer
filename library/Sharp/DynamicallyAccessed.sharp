namespace Sharp;

import Attribute;

// Spec section 5: on an attribute class, says that a framework reads the attribute to reach the member it marks, or
// every public member of the class it marks, by reflection, as a router reaches a `[Route]` method. The checker sees
// no such use, so it counts each as used.
[Attribute(Attribute.TARGET_CLASS)]
public class DynamicallyAccessed
{
}
