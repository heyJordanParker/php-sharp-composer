namespace Sharp.Math;

import DivisionByZeroError;

public static class Math
{
    public static float ceil(float x) => global.ceil(x);

    public static float floor(float x) => global.floor(x);

    public static float sqrt(float x) => global.sqrt(x);

    public static float log(float x) => global.log(x);

    public static float round(float x, int precision = 0) => global.round(x, precision);

    public static float pow(float base, float exponent)
        => base == 0.0 && exponent < 0.0
            ? throw new DivisionByZeroError("Math.pow: a base of 0 with a negative exponent divides by zero")
            : base ** exponent;
}
