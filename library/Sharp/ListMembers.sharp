namespace Sharp;

import Sharp.Internal;
import Sharp.Internal.ComparedByEquality;
import Sharp.Internal.ComparedByOrder;
import Sharp.Internal.SearchesElements;

extern Internal.add;
extern Internal.insert;
extern Internal.set;
extern Internal.remove;
extern Internal.removeAt;
extern Internal.removeLast;
extern Internal.clear;
extern Internal.get;
extern Internal.contains;
extern Internal.indexOf;
extern Internal.nonEmpty;
extern Internal.entries;
extern Internal.toSet;
extern Internal.filter;
extern Internal.map;
extern Internal.flatMap;
extern Internal.sumOf;
extern Internal.first;
extern Internal.any;
extern Internal.groupBy;
extern Internal.associateBy;
extern Internal.sortedBy;
extern Internal.firstOrNull;
extern Internal.sortedByDescending;
extern Internal.sortedWith;
extern Internal.minBy;
extern Internal.maxBy;

// The members of a `List`, spec section 12. A member that changes the list takes it by `ref`, spec section 26.
public static class ListMembers
{
    extension<T>(List<T> items)
    {
        public int count() => global.count(items);

        public bool isEmpty() => global.count(items) == 0;

        public bool isNotEmpty() => global.count(items) != 0;

        public T? getOrNull(int index) => Internal.get(items, index);

        [SearchesElements]
        public bool contains([ComparedByEquality] T value) => Internal.contains(items, value);

        [SearchesElements]
        public int? indexOf([ComparedByEquality] T value) => Internal.indexOf(items, value);

        public T last() => global.array_last(Internal.nonEmpty(items));

        public List<T> toList() => items;

        public Set<T> toSet() => Internal.toSet(items);

        public Map<int, T> entries() => Internal.entries(items);

        public List<T> filter(Function<bool(T)> predicate) => Internal.filter(items, predicate);

        public List<TResult> map<TResult>(Function<TResult(T)> transform) => Internal.map(items, transform);

        public List<TResult> flatMap<TResult>(Function<Iterable<TResult>(T)> transform) => Internal.flatMap(items, transform);

        public TResult sumOf<TResult : int|float>(Function<TResult(T)> selector) => Internal.sumOf(items, selector);

        public T first(Function<bool(T)> predicate) => Internal.first(items, predicate);

        public T? firstOrNull(Function<bool(T)> predicate) => Internal.firstOrNull(items, predicate);

        public int? indexOfFirst(Function<bool(T)> predicate)
        {
            for (let index = 0; index < items.count(); index++) {
                if (predicate(items[index])) {
                    return index;
                }
            }
            return null;
        }

        public bool any(Function<bool(T)> predicate) => Internal.any(items, predicate);

        public Map<TKey, List<T>> groupBy<TKey>(Function<TKey(T)> key) => Internal.groupBy(items, key);

        public Map<TKey, T> associateBy<TKey>(Function<TKey(T)> key) => Internal.associateBy(items, key);

        // A tuple key, as `p => [p.last, p.first]` gives, orders element by element.
        public List<T> sortedBy<TKey>([ComparedByOrder] Function<TKey(T)> selector) => Internal.sortedBy(items, selector);

        public List<T> sortedByDescending<TKey>([ComparedByOrder] Function<TKey(T)> selector)
            => Internal.sortedByDescending(items, selector);

        // The comparison gives below 0 when its first element goes before its second.
        public List<T> sortedWith(Function<int(T, T)> comparison) => Internal.sortedWith(items, comparison);

        // The first element of the smallest key.
        public T minBy<TKey>([ComparedByOrder] Function<TKey(T)> selector) => Internal.minBy(items, selector);

        public T maxBy<TKey>([ComparedByOrder] Function<TKey(T)> selector) => Internal.maxBy(items, selector);

        // Each pair of elements at one index, as long as the shorter list.
        public List<[T, TOther]> zip<TOther>(List<TOther> other)
        {
            List<[T, TOther]> pairs = [];
            for (let index = 0; index < items.count() && index < other.count(); index++) {
                pairs.add([items[index], other[index]]);
            }
            return pairs;
        }

        // Each run of `size` elements in a row, in order, so none for a size past the length.
        public List<List<T>> windowed(int size)
        {
            if (size < 1) {
                throw new ValueError("`windowed` takes a size of 1 or more, and it is smaller.");
            }
            List<List<T>> windows = [];
            for (let start = 0; start + size <= items.count(); start++) {
                windows.add(items.slice(start, start + size));
            }
            return windows;
        }

        // The elements the predicate matches, then the others, each in order.
        public [List<T>, List<T>] partition(Function<bool(T)> predicate)
        {
            List<T> matches = [];
            List<T> others = [];
            for (const item of items) {
                if (predicate(item)) {
                    matches.add(item);
                } else {
                    others.add(item);
                }
            }
            return [matches, others];
        }

        // In a list sorted by the comparison, the index of an element it gives 0 for, or null when none. It gives an
        // element's order against what is sought.
        public int? binarySearch(Function<int(T)> comparison)
        {
            let low = 0;
            let high = items.count() - 1;
            while (low <= high) {
                const middle = (low + high) / 2;
                const order = comparison(items[middle]);
                if (order == 0) {
                    return middle;
                }
                if (order < 0) {
                    low = middle + 1;
                } else {
                    high = middle - 1;
                }
            }
            return null;
        }

        // In a list where the predicate holds for each element before the first it fails for, that element's index, or
        // the count when it holds for all: where a sought element goes.
        public int partitionPoint(Function<bool(T)> predicate)
        {
            let low = 0;
            let high = items.count();
            while (low < high) {
                const middle = (low + high) / 2;
                if (predicate(items[middle])) {
                    low = middle + 1;
                } else {
                    high = middle;
                }
            }
            return low;
        }

        public List<T> reversed() => global.array_reverse(items);

        public List<T> distinct() => global.array_values(global.array_unique(items, global.SORT_REGULAR));

        public List<T> slice(int start, int? end = null)
        {
            const stop = end ?? items.count();
            if (start < 0 || stop < start || stop > items.count()) {
                throw new OutOfRangeException("`slice` takes a range inside the list, and the range is outside it.");
            }
            return global.array_slice(items, start, stop - start);
        }

        public List<List<T>> chunked(int size)
            => size < 1
                ? throw new ValueError("`chunked` takes a size of 1 or more, and it is smaller.")
                : global.array_chunk(items, size);

        public bool all(Function<bool(T)> predicate) => !items.any((T item) => !predicate(item));

        public TResult fold<TResult>(TResult initial, Function<TResult(TResult, T)> operation)
            => global.array_reduce(items, operation, initial);
    }

    extension<T>(ref List<T> list)
    {
        public void add(T value) => Internal.add(list, value);

        public void insert(int index, T value) => Internal.insert(list, index, value);

        // `list[i] = v` runs it, and it gives the element it replaced.
        public T set(int index, T value) => Internal.set(list, index, value);

        [SearchesElements]
        public bool remove([ComparedByEquality] T value) => Internal.remove(list, value);

        public T removeAt(int index) => Internal.removeAt(list, index);

        public T removeFirst() => Internal.removeAt(list, 0);

        public T removeLast() => Internal.removeLast(list);

        public void clear() => Internal.clear(list);

        // Removes each element the predicate matches, and gives whether it removed one.
        public bool removeAll(Function<bool(T)> predicate)
        {
            const count = list.count();
            list = Internal.filter(list, (T item) => !predicate(item));
            return list.count() != count;
        }
    }

    extension(List<int> numbers)
    {
        public int max() => global.max(Internal.nonEmpty(numbers));

        public int min() => global.min(Internal.nonEmpty(numbers));

        // The text of the bytes, each an `int` from 0 to 255, as `Int.toByteString()` gives one byte's.
        public string toByteString() => global.implode("", numbers.map((int byte) => byte.toByteString()));
    }

    extension(List<string> fields)
    {
        // The fields as one CSV record of RFC 4180, which `parseCsv()` reads back: a field that holds a comma, a quote or
        // a line break is quoted, with each quote doubled.
        public string toCsv()
            => global.implode(",", fields.map((string field) => global.strpbrk(field, ",\"\r\n") is string ? `"${global.str_replace("\"", "\"\"", field)}"` : field));
    }
}
