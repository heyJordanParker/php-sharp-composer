namespace Sharp.Data;

import ValueError;

public static class Binary
{
    public static string pack(string format, Any? ...values) => global.pack(format, ...values);

    public static Map<int|string, Any?> unpack(string format, string data)
    {
        const values = @global.unpack(format, data);
        return (values is false) ? throw new ValueError("Binary.unpack: the data does not fit the format") : values;
    }
}
