namespace Sharp.Data;

public static class PhpSerializer
{
    public static string serialize(Any? value) => global.serialize(value);

    public static Any? unserialize(string text, List<string> allowedClasses = [])
    {
        global.error_clear_last();
        // A class is named as PHP# writes it, as `Shop.Crate`, which PHP names `Shop\Crate`.
        const value = global.unserialize(text, ["allowed_classes": allowedClasses.map(name => global.strtr(name, ".", "\\"))]);
        return global.error_get_last() == null ? value : null;
    }

    public static string export(Any? value) => global.var_export(value, true);
}
