namespace Sharp.Data;

// A SQL database. A row is a `Map<string, Any?>`, which a struct's `parse` turns into a typed value. A module binds
// `SystemDatabase` to a connection, and a test passes a `Sharp.Testing.FakeDatabase`.
public effect abstract class Database
{
    // Every row.
    public abstract List<Map<string, Any?>> query(string sql, List<Any?> parameters = []);

    // The first row, null when there are none.
    public abstract Map<string, Any?>? queryFirst(string sql, List<Any?> parameters = []);

    // The first column of the first row, null when there are none.
    public abstract Any? scalar(string sql, List<Any?> parameters = []);

    // The number of rows a change affected.
    public abstract int execute(string sql, List<Any?> parameters = []);

    public abstract void beginTransaction();

    public abstract void commit();

    public abstract void rollback();
}
