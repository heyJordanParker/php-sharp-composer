namespace Sharp.Data;

import Sharp.Time.Duration;

// A key-value store. Values are `Bytes`, spec section 18, so text is kept as `text.toBytes()` and a structured value
// goes through `Json`. A module binds `SystemCache` to a SQLite file, and a test passes a `Sharp.Testing.FakeCache`.
public effect abstract class Cache
{
    // null on a miss or an expired entry.
    public abstract Bytes? get(string key);

    public abstract void set(string key, Bytes value, Duration? expiresAfter = null);

    // A missing key is not an error.
    public abstract void remove(string key);

    // The cached value, or else the one `create` gives, which the cache keeps. Each call has the effects of `create`.
    public abstract Bytes getOrCreate(string key, Function<Bytes()> create, Duration? expiresAfter = null);
}
