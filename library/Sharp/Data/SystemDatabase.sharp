namespace Sharp.Data;

import PDO;
import PDOException;
import PDOStatement;

// A database through PDO. A failing statement throws `PDOException`, a `RuntimeException`.
public effect class SystemDatabase : Database
{
    private PDO connection;

    // A PDO connection string, as "sqlite::memory:" or "pgsql:host=db;dbname=shop". A module sets it.
    public SystemDatabase(string connection, string? user = null, string? password = null)
    {
        try {
            this.connection = new PDO(connection, user, password, [PDO.ATTR_ERRMODE: PDO.ERRMODE_EXCEPTION]);
        } catch (PDOException failure) {
            throw new RuntimeException(`Database: cannot connect: ${failure.getMessage()}`);
        }
    }

    public override List<Map<string, Any?>> query(string sql, List<Any?> parameters = [])
    {
        const statement = this.run("Database.query", sql, parameters);
        List<Map<string, Any?>> rows = [];
        while (SystemDatabase.next(statement) is Map<string, Any?> row) {
            rows.add(row);
        }

        return rows;
    }

    public override Map<string, Any?>? queryFirst(string sql, List<Any?> parameters = [])
        => SystemDatabase.next(this.run("Database.queryFirst", sql, parameters));

    public override Any? scalar(string sql, List<Any?> parameters = [])
        => this.run("Database.scalar", sql, parameters).fetch(PDO.FETCH_NUM) is List<Any?> row ? row[0] : null;

    public override int execute(string sql, List<Any?> parameters = []) => this.run("Database.execute", sql, parameters).rowCount();

    // MySQL sets the level of its next transaction, Postgres sets it as its transaction's first statement, and SQLite
    // runs every transaction serializable.
    protected override void begin()
    {
        const driver = this.connection.getAttribute(PDO.ATTR_DRIVER_NAME);
        if (driver == "mysql") {
            this.connection.exec("SET TRANSACTION ISOLATION LEVEL SERIALIZABLE");
        }
        this.connection.beginTransaction();
        if (driver == "pgsql") {
            this.connection.exec("SET TRANSACTION ISOLATION LEVEL SERIALIZABLE");
        }
    }

    protected override void commit()
    {
        this.connection.commit();
    }

    protected override void rollback()
    {
        this.connection.rollBack();
    }

    // A serialization failure or a deadlock, SQLSTATE 40001 or 40P01, which Postgres and MySQL give, or SQLite's
    // SQLITE_BUSY, which it gives a writer another transaction's write blocks.
    protected override bool conflicted(Throwable failure)
        => failure is PDOException refused
            && (refused.getCode() == "40001" || refused.getCode() == "40P01" || refused.errorInfo is Map<int|string, Any?> info && info.get(1) == 5);

    // The statement's next row, null after the last.
    private static Map<string, Any?>? next(PDOStatement statement)
        => statement.fetch(PDO.FETCH_ASSOC) is Map<string, Any?> row ? row : null;

    private PDOStatement run(string member, string sql, List<Any?> parameters)
    {
        if (this.connection.prepare(sql) is not PDOStatement statement) {
            throw new RuntimeException(`${member}: the database cannot run "${sql}"`);
        }
        statement.execute(parameters);

        return statement;
    }
}
