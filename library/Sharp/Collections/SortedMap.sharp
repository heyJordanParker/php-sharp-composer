namespace Sharp.Collections;

import Sharp.Internal;

extern Internal.compare uses none;

// A map that keeps its keys in order, with every member a `Map` has.
// It orders by the key's `operator <=>`, as `<` orders two keys, or by the comparison its constructor takes, which
// gives below 0 when its first key goes before its second. Two keys the order puts at 0 are one key. It keeps its keys
// in a sorted list, so a read takes log n steps, and a write moves the entries after its key.
public class SortedMap<TKey, TValue> : Iterable<[TKey, TValue]>
{
    private Function<int(TKey, TKey)> order;

    private List<TKey> sortedKeys = [];

    private List<TValue> sortedValues = [];

    public SortedMap(Function<int(TKey, TKey) uses none>? comparison = null)
    {
        this.order = comparison ?? ((TKey a, TKey b) => Internal.compare(a, b));
    }

    // `map[key]` reads the value of the key, or null, and `map[key] = value` sets it, as a `Map`'s do.
    public TValue? this[TKey key]
    {
        get => this.get(key);
        set => this.set(key, value ?? throw new ValueError("SortedMap: an entry holds a value, and null is none: remove the key instead"));
    }

    // Each entry, as `[key, value]`, in key order.
    public Iterable<[TKey, TValue]> elements() => this.toList();

    public int count() => this.sortedKeys.count();

    public bool isEmpty() => this.sortedKeys.isEmpty();

    public bool isNotEmpty() => this.sortedKeys.isNotEmpty();

    public TValue? get(TKey key) => this.has(key) ? this.sortedValues[this.position(key)] : null;

    public bool has(TKey key)
    {
        const at = this.position(key);

        return at < this.sortedKeys.count() && this.order(this.sortedKeys[at], key) == 0;
    }

    public List<TKey> keys() => this.sortedKeys;

    public List<TValue> values() => this.sortedValues;

    public List<[TKey, TValue]> toList() => this.sortedKeys.zip(this.sortedValues);

    public SortedMap<TKey, TValue> filter(Function<bool(TValue)> predicate)
    {
        const kept = new SortedMap<TKey, TValue>(this.order);
        for (const [key, value] of this.toList()) {
            if (predicate(value)) {
                kept.sortedKeys.add(key);
                kept.sortedValues.add(value);
            }
        }

        return kept;
    }

    public List<TResult> map<TResult>(Function<TResult(TValue)> transform) => this.sortedValues.map(transform);

    public TResult sumOf<TResult : int|float>(Function<TResult(TValue)> selector) => this.sortedValues.sumOf(selector);

    // The value of the first key, or of the first key whose value the predicate matches, as a `Map`'s first. An empty
    // map throws `OutOfRangeException`.
    public TValue first(Function<bool(TValue)>? predicate = null)
    {
        if (predicate is Function<bool(TValue)> matches) {
            return this.sortedValues.first(matches);
        }

        return this.sortedValues.isEmpty() ? throw new OutOfRangeException("SortedMap.first: the map is empty") : this.sortedValues[0];
    }

    public TValue? firstOrNull(Function<bool(TValue)> predicate) => this.sortedValues.firstOrNull(predicate);

    // The value of the last key. An empty map throws `OutOfRangeException`.
    public TValue last()
        => this.sortedValues.isEmpty() ? throw new OutOfRangeException("SortedMap.last: the map is empty") : this.sortedValues[this.sortedValues.count() - 1];

    public bool any(Function<bool(TValue)> predicate) => this.sortedValues.any(predicate);

    public Map<TGroup, List<TValue>> groupBy<TGroup : Equatable>(Function<TGroup(TValue)> key) => this.sortedValues.groupBy(key);

    public Map<TGroup, TValue> associateBy<TGroup : Equatable>(Function<TGroup(TValue)> key) => this.sortedValues.associateBy(key);

    // The values in the order of the keys `selector` gives them, as `<` orders those keys.
    public List<TValue> sortedBy<TOrder>(Function<TOrder(TValue)> selector)
        => this.sortedValues.sortedWith((TValue a, TValue b) => Internal.compare(selector(a), selector(b)));

    // The largest key at or below `key`, or null.
    public TKey? floor(TKey key)
    {
        const at = this.position(key);
        if (at < this.sortedKeys.count() && this.order(this.sortedKeys[at], key) == 0) {
            return this.sortedKeys[at];
        }

        return at > 0 ? this.sortedKeys[at - 1] : null;
    }

    // The smallest key at or above `key`, or null.
    public TKey? ceiling(TKey key)
    {
        const at = this.position(key);

        return at < this.sortedKeys.count() ? this.sortedKeys[at] : null;
    }

    // The entries from the key `from` up to the key `to`, `to` itself left out.
    public SortedMap<TKey, TValue> range(TKey from, TKey to)
    {
        const inside = new SortedMap<TKey, TValue>(this.order);
        const end = this.position(to);
        for (let at = this.position(from); at < end; at++) {
            inside.sortedKeys.add(this.sortedKeys[at]);
            inside.sortedValues.add(this.sortedValues[at]);
        }

        return inside;
    }

    // Removes the entry of `key`, and gives whether the map held one.
    public bool remove(TKey key)
    {
        if (!this.has(key)) {
            return false;
        }
        const at = this.position(key);
        this.sortedKeys.removeAt(at);
        this.sortedValues.removeAt(at);

        return true;
    }

    // Sets the value of `key`, in place of the value it had.
    public void set(TKey key, TValue value)
    {
        const at = this.position(key);
        if (at < this.sortedKeys.count() && this.order(this.sortedKeys[at], key) == 0) {
            this.sortedValues[at] = value;
        } else {
            this.sortedKeys.insert(at, key);
            this.sortedValues.insert(at, value);
        }
    }

    // The value of the key, or, when the map holds no such key, what `defaultValue` gives, set under the key first, as
    // a `Map`'s getOrPut.
    public TValue getOrPut(TKey key, Function<TValue()> defaultValue)
    {
        if (this.has(key)) {
            return this.sortedValues[this.position(key)];
        }
        const value = defaultValue();
        this.set(key, value);

        return value;
    }

    // The index of the first key the order puts at or after `key`.
    private int position(TKey key) => this.sortedKeys.partitionPoint((TKey held) => this.order(held, key) < 0);
}
