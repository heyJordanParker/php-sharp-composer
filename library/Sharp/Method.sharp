namespace Sharp;

import Sharp.Internal.CreatesAttributes;
import Sharp.Internal.NamesMember;

extern Internal.createDelegate uses none;
extern Internal.createInvoker uses none;
// A method a class declares, as `Class<T>.methods()` gives it, spec section 25: the class that declares it, its name,
// its modifiers, its visibility, its result type as declared, `void` for a `void` method, and its parameters. A method
// is virtual when a subclass may replace it: a PHP# one that is `virtual`, `abstract` or an `override` not `final`, and
// a plain PHP one PHP doesn't mark `final` or `private`, spec section 22. The engine creates it, for the class value it
// was read from.
public class Method
{
    internal Method(
        private Class<Any?> readOn,
        public Class<Object> declaringClass { get; },
        [NamesMember] public string name { get; },
        public bool isStatic { get; },
        public bool isVirtual { get; },
        public bool isAbstract { get; },
        public bool isOverride { get; },
        public Visibility visibility { get; },
        public Class<Any?> type { get; },
        private List<Parameter> declared
    ) { }

    // Two values are one method when they name it in the class that declares it, so a `Map<Method, V>` keys by the
    // method whenever `methods()` read it.
    public static bool operator ==(Method a, Method b) => a.declaringClass == b.declaringClass && a.name == b.name;

    public int hash() => global.crc32(this.declaringClass.name() + "::" + this.name);

    // The method's parameters, in order.
    public List<Parameter> parameters() => this.declared;

    // A value of the function type `TFunction` that calls the method, as `Function<Relation(Order) uses Database>`: an
    // instance method takes its receiver as the type's first parameter, and a static one takes none and runs on the
    // class it was read from. The calling code reaches the method as a direct call would. The method's parameters,
    // result and effects must fit the type, as a function's must to be assigned to it, spec section 21, or it throws
    // ValueError naming the one that doesn't. The method's effects are those its body has, spec section 29, so a call of
    // the value has only those `TFunction` lists, and making it is pure. A plain PHP method has those its `extern` lines
    // declare, and may have every effect without one. A call on a receiver whose override has an effect the type
    // doesn't list throws ValueError.
    public TFunction createDelegate<TFunction>()
        => Internal.createDelegate(this.readOn, this.declaringClass, this.name, typeof(TFunction));

    // A value of the function type `TFunction` that calls the method with a list of arguments, as
    // `Function<Any?(Object, List<Any?>) uses Database>`: an instance method takes its receiver, then the `List<Any?>`,
    // and a static one takes the list alone and runs on the class it was read from. It fits `TFunction` as
    // `createDelegate` does, but for its parameters, so a call of the value has only the effects `TFunction` lists, and
    // making it is pure. A call checks each value of the list against the parameter at its place, as a direct call does,
    // and throws TypeError naming the one it doesn't fit. A parameter the list leaves out takes its default when that
    // runs no code, as `Parameter.defaultValue()` reads it, and the call throws ValueError for one that runs code and
    // ArgumentCountError for a required one or a value past the last parameter.
    public TFunction createInvoker<TFunction>()
        => Internal.createInvoker(this.readOn, this.declaringClass, this.name, typeof(TFunction));

    // The attributes of the method of the class `TAttribute` or of a class that extends or implements it, as
    // `Class<T>.attributes()` gives a class's.
    [CreatesAttributes]
    public List<TAttribute> attributes<TAttribute : Object>()
        => Internal.attributes(this.declaringClass, "method", this.name, 0, typeof(TAttribute));

    // The attributes `attributes<TAttribute>()` gives, each as written, building none, spec section 25.
    public List<AttributeData> attributeData<TAttribute : Object>()
        => Internal.attributeData(this.declaringClass, "method", this.name, 0, typeof(TAttribute), typeof(AttributeData));
}
