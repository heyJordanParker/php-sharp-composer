namespace Sharp;

import Sharp.Internal.CreatesAttributes;
import Sharp.Internal.NamesMember;

// A case of an enum, as `Class<T>.enumCases()` gives it, spec section 25: its name, the case itself, and its backing
// value, the int or the string, null for a pure enum's. The engine creates it.
public class EnumCase
{
    internal EnumCase(
        [NamesMember] public string name { get; },
        public Object value { get; },
        public Any? backingValue { get; }
    ) { }

    // Two values are one case when they name it in one enum.
    public static bool operator ==(EnumCase a, EnumCase b) => Class.of(a.value) == Class.of(b.value) && a.name == b.name;

    public int hash() => global.crc32(Class.of(this.value).name() + "::" + this.name);

    // The attributes of the case of the class `TAttribute` or of a class that extends or implements it, as
    // `Class<T>.attributes()` gives a class's.
    [CreatesAttributes]
    public List<TAttribute> attributes<TAttribute : Object>()
        => Internal.attributes(Class.of(this.value), "constant", this.name, 0, typeof(TAttribute));

    // The attributes `attributes<TAttribute>()` gives, each as written, building none, spec section 25.
    public List<AttributeData> attributeData<TAttribute : Object>()
        => Internal.attributeData(Class.of(this.value), "constant", this.name, 0, typeof(TAttribute), typeof(AttributeData));
}
