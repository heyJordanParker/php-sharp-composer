namespace Sharp.Net;

// One mailbox, with an optional display name, as .NET's MailAddress.
public struct MailAddress
{
    public MailAddress(public string address { get; }, public string? name = null { get; })
    {
        if (!Email.isValid(address)) {
            throw new ValueError(`MailAddress: "${address}" is not a valid address`);
        }
    }

    // The address as a mail header writes it, as `Ann <ann@example.com>`.
    public string header => this.name is string name ? `${global.addcslashes(name, "\"\\")} <${this.address}>` : this.address;
}
