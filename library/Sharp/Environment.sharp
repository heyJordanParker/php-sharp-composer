namespace Sharp;

import Error;
import ValueError;

public foreign class Environment
{
    public List<string> arguments { get; }

    public string currentDirectory { get; }

    public Environment()
    {
        this.arguments = Environment.commandLine();
        this.currentDirectory = getcwd() is string directory ? directory : throw new Error("Environment: the current directory cannot be read");
    }

    public string? variable(string name) => getenv(name) is string value ? value : null;

    public static string require(string name)
        => getenv(name) is string value ? value : throw new ValueError(`Environment.require: the environment variable "${name}" is not set`);

    private static extern List<string> commandLine();
}
