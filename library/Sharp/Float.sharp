namespace Sharp;

public static class Float
{
    public static float parse(string text)
    {
        const number = Float.tryParse(text);
        if (number is float) {
            return number;
        }
        if (Float.isNumber(text)) {
            throw new ArithmeticError(`Float.parse: "${text}" is out of range for a float`);
        }
        if (Float.isNumber(global.trim(text))) {
            throw new ValueError(`Float.parse: "${text}" is not a float: remove its spaces with trim() first`);
        }
        throw new ValueError(`Float.parse: "${text}" is not a float`);
    }

    public static float? tryParse(string text)
    {
        const number = Float.isNumber(text) ? global.floatval(text) : null;
        return (number is float) && global.is_finite(number) ? number : null;
    }

    private static bool isNumber(string text)
        => global.preg_match("/\\A[+-]?([0-9]+(\\.[0-9]+)?|\\.[0-9]+)([eE][+-]?[0-9]+)?\\z/", text) is int found && found == 1;

    extension(float value)
    {
        public float abs() => global.abs(value);

        public float clamp(float min, float max)
            => min > max
                ? throw new ValueError("`clamp` needs a minimum no larger than its maximum, and the minimum is larger.")
                : value < min ? min : value > max ? max : value;

        public float round(int decimals = 0) => global.round(value, decimals);

        public float floor() => global.floor(value);

        public float ceil() => global.ceil(value);

        public bool isFinite() => global.is_finite(value);

        public string format(int decimals = 0, string decimalSeparator = ".", string thousandsSeparator = ",")
            => global.number_format(value, decimals, decimalSeparator, thousandsSeparator);
    }
}
