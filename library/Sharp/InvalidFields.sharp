namespace Sharp;

public class InvalidFields : ValueError
{
    public InvalidFields(public Map<string, string> fields { get; }) : super(InvalidFields.describe(fields)) { }

    private static string describe(Map<string, string> fields)
    {
        let message = "";
        for (const [path, problem] of fields) {
            const part = path == "" ? problem : `${path}: ${problem}`;
            message = message == "" ? part : `${message}; ${part}`;
        }
        return message;
    }
}
