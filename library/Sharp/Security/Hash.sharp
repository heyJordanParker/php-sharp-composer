namespace Sharp.Security;

public static class Hash
{
    public static string of(string algorithm, string data) => global.hash(algorithm, data);

    public static string hmac(string algorithm, string data, string key) => global.hash_hmac(algorithm, data, key);

    public static string md5(string data) => global.md5(data);

    public static string sha1(string data) => global.sha1(data);

    public static int crc32(string data) => global.crc32(data);

    public static bool equals(string known, string given) => global.hash_equals(known, given);
}
