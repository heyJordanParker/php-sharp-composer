namespace Sharp.Security;

// A keyed hash that signs data, as .NET's HMAC and Java's Mac, in lowercase hex.
public static class Hmac
{
    public static string of(string algorithm, string data, string key) => global.hash_hmac(algorithm, data, key);

    // Whether `signature` is the HMAC of `data`, compared in constant time, as a webhook's signature is checked.
    public static bool verify(string algorithm, string data, string key, string signature)
        => global.hash_equals(Hmac.of(algorithm, data, key), signature);
}
