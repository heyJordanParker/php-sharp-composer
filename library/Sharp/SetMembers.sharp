namespace Sharp;

import Sharp.Internal;
import Sharp.Internal.ComparedByEquality;
import Sharp.Internal.ComparedByOrder;
import Sharp.Internal.SearchesElements;

extern Internal.addKey;
extern Internal.filterElements;

// The members of a `Set`, spec section 12. A member that changes the set takes it by `ref`, spec section 26. A `Set`'s
// elements are its table's keys, which the functions a `Map` shares find, remove and list.
public static class SetMembers
{
    extension<T>(Set<T> set)
    {
        public int count() => Internal.size(set);

        public bool isEmpty() => Internal.size(set) == 0;

        public bool isNotEmpty() => Internal.size(set) != 0;

        [SearchesElements]
        public bool contains([ComparedByEquality] T value) => Internal.containsKey(set, value);

        public List<T> toList() => Internal.keys(set);

        public Set<T> filter(Function<bool(T)> predicate) => Internal.filterElements(set, predicate);

        public List<TResult> map<TResult>(Function<TResult(T)> transform) => Internal.map(set, transform);

        public TResult sumOf<TResult : int|float>(Function<TResult(T)> selector) => Internal.sumOf(set, selector);

        public T first(Function<bool(T)> predicate) => Internal.first(set, predicate);

        public T? firstOrNull(Function<bool(T)> predicate) => Internal.firstOrNull(set, predicate);

        public bool any(Function<bool(T)> predicate) => Internal.any(set, predicate);

        public List<T> sortedBy<TKey>([ComparedByOrder] Function<TKey(T)> selector) => Internal.sortedBy(set, selector);

        // The elements of either set, this set's first, each once, as Kotlin's union.
        public Set<T> union(Set<T> other)
        {
            Set<T> united = set;
            for (const element of other) {
                Internal.addKey(united, element);
            }
            return united;
        }

        // The elements of this set that the other holds too, in this set's order, as Kotlin's intersect.
        public Set<T> intersect(Set<T> other) => Internal.filterElements(set, (T element) => Internal.containsKey(other, element));

        // The elements of this set that the other doesn't hold, in order, as Kotlin's subtract.
        public Set<T> subtract(Set<T> other) => Internal.filterElements(set, (T element) => !Internal.containsKey(other, element));

        // Whether the other set holds every element of this one, as Rust's is_subset.
        public bool isSubsetOf(Set<T> other) => !Internal.any(set, (T element) => !Internal.containsKey(other, element));
    }

    extension<T>(ref Set<T> set)
    {
        public bool add([ComparedByEquality] T value) => Internal.addKey(set, value);

        [SearchesElements]
        public bool remove([ComparedByEquality] T value) => Internal.removeKey(set, value);

        public void clear() => Internal.clear(set);
    }
}
