namespace Sharp.IO;

// Standard output, standard error and standard input. PHP# strings interpolate with `${}`, so no member takes a format
// string. A module binds `SystemConsole`, the process's own streams, and a test passes a `Sharp.Testing.FakeConsole`.
public effect abstract class Console
{
    // To standard output.
    public abstract void write(string text);

    // To standard output, then a newline.
    public abstract void writeLine(string text);

    // To standard error.
    public abstract void writeError(string text);

    // One line of standard input without its line ending, null at the end of the input.
    public abstract string? readLine();
}
