namespace Sharp.IO;

import Sharp.Time.Instant;

// The disk's files and folders.
public effect class SystemFiles : Files
{
    public override string? read(string path) => SystemFiles.contents(path, "Files.read")?.toText();

    public override Bytes? readBytes(string path) => SystemFiles.contents(path, "Files.readBytes");

    public override List<string>? readLines(string path)
    {
        if (this.read(path) is not string contents) {
            return null;
        }

        if (contents == "") {
            return [];
        }

        return global.preg_split("/\\r\\n|\\n|\\r/", global.rtrim(contents, "\r\n")) is List<string> lines ? lines : [];
    }

    public override Iterable<string>? readLinesLazily(string path)
    {
        SystemFiles.local(path, "Files.readLinesLazily");

        return global.is_file(path) ? SystemFiles.lines(path) : null;
    }

    public override void write(string path, string contents) => SystemFiles.put(path, contents, 0, "Files.write");

    public override void writeBytes(string path, Bytes contents) => SystemFiles.put(path, contents.data, 0, "Files.writeBytes");

    public override void append(string path, string contents) => SystemFiles.put(path, contents, global.FILE_APPEND, "Files.append");

    public override bool exists(string path) => global.is_file(path);

    public override bool isDirectory(string path) => global.is_dir(path);

    public override void delete(string path)
    {
        if (global.is_file(path) && !global.unlink(path)) {
            throw new RuntimeException(`Files.delete: "${path}" cannot be deleted`);
        }
    }

    public override void copy(string from, string to)
    {
        if (!global.copy(from, to)) {
            throw new RuntimeException(`Files.copy: "${from}" cannot be copied to "${to}"`);
        }
    }

    public override void move(string from, string to)
    {
        if (!global.rename(from, to)) {
            throw new RuntimeException(`Files.move: "${from}" cannot be moved to "${to}"`);
        }
    }

    public override List<string>? list(string directory)
    {
        if (!global.is_dir(directory)) {
            return null;
        }
        if (global.scandir(directory) is not List<string> entries) {
            throw new RuntimeException(`Files.list: "${directory}" cannot be read`);
        }

        return entries.filter(entry => entry != "." && entry != "..");
    }

    public override void createDirectory(string path)
    {
        if (!global.is_dir(path) && !global.mkdir(path, 0o777, true)) {
            throw new RuntimeException(`Files.createDirectory: "${path}" cannot be created`);
        }
    }

    public override void deleteDirectory(string path)
    {
        if (!global.rmdir(path)) {
            throw new RuntimeException(`Files.deleteDirectory: "${path}" cannot be deleted`);
        }
    }

    public override int? size(string path) => global.is_file(path) && global.filesize(path) is int size ? size : null;

    public override Instant? lastModified(string path) => global.file_exists(path) && global.filemtime(path) is int time ? new Instant(time) : null;

    public override string temporaryFile()
        => global.tempnam(global.sys_get_temp_dir(), "sharp") is string path ? path : throw new RuntimeException("Files.temporaryFile: no temporary file can be created");

    public override string temporaryDirectory() => global.sys_get_temp_dir();

    public override Iterable<string>? walk(string directory)
    {
        SystemFiles.local(directory, "Files.walk");

        return global.is_dir(directory) ? SystemFiles.entries(global.rtrim(directory, "/")) : null;
    }

    private static Iterable<string> lines(string path)
    {
        const handle = global.fopen(path, "r");
        if (handle is bool) {
            throw new RuntimeException(`Files.readLinesLazily: "${path}" cannot be read`);
        }
        try {
            while (global.fgets(handle) is string line) {
                yield Bytes.held(global.rtrim(line, "\r\n")).toText();
            }
        } finally {
            global.fclose(handle);
        }
    }

    private static Iterable<string> entries(string directory)
    {
        if (global.scandir(directory) is not List<string> names) {
            throw new RuntimeException(`Files.walk: "${directory}" cannot be read`);
        }
        for (const name of names) {
            if (name != "." && name != "..") {
                const path = `${directory}/${name}`;
                yield path;
                if (global.is_dir(path) && !global.is_link(path)) {
                    yield ...SystemFiles.entries(path);
                }
            }
        }
    }

    // The bytes of the file at `path` for `member`, or null when the file doesn't exist.
    private static Bytes? contents(string path, string member)
    {
        SystemFiles.local(path, member);
        if (!global.is_file(path)) {
            return null;
        }

        return global.file_get_contents(path) is string contents
            ? Bytes.held(contents)
            : throw new RuntimeException(`${member}: "${path}" cannot be read`);
    }

    private static void put(string path, string contents, int flags, string member)
    {
        SystemFiles.local(path, member);
        if (global.file_put_contents(path, contents, flags) == false) {
            throw new RuntimeException(`${member}: "${path}" cannot be written`);
        }
    }

    // A path names a file on this disk, never a URL that PHP's stream wrappers would fetch.
    private static void local(string path, string member)
    {
        if (global.preg_match("~^[a-z][a-z0-9+.-]*://~i", path) == 1) {
            throw new ValueError(`${member}: "${path}" is a URL, and Files reads only files`);
        }
    }
}
