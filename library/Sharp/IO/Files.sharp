namespace Sharp.IO;

import Sharp.Time.Instant;

// Whole files and folders. A missing file is a returned null. A module binds `SystemFiles`, the disk's, and a test
// passes a `Sharp.Testing.FakeFiles`.
public effect abstract class Files
{
    // The file as text, each byte sequence that is not UTF-8 read as U+FFFD, spec section 18. null when the file
    // doesn't exist.
    public abstract string? read(string path);

    // The file's bytes, every one kept. null when the file doesn't exist.
    public abstract Bytes? readBytes(string path);

    // The lines without their endings, null when the file doesn't exist.
    public abstract List<string>? readLines(string path);

    // The lines without their endings, read one at a time as a loop reaches them, so a file of any size streams
    // through. null when the file doesn't exist.
    public abstract Iterable<string>? readLinesLazily(string path);

    // Replaces the file.
    public abstract void write(string path, string contents);

    // Replaces the file with the bytes.
    public abstract void writeBytes(string path, Bytes contents);

    // Adds to the end of the file.
    public abstract void append(string path, string contents);

    public abstract bool exists(string path);

    public abstract bool isDirectory(string path);

    // A missing file is not an error.
    public abstract void delete(string path);

    public abstract void copy(string from, string to);

    public abstract void move(string from, string to);

    // Entry names without . and .., in name order, null when the folder doesn't exist.
    public abstract List<string>? list(string directory);

    // Creates the parents too. An existing folder is not an error.
    public abstract void createDirectory(string path);

    // An empty folder.
    public abstract void deleteDirectory(string path);

    // Bytes, null when the file is missing.
    public abstract int? size(string path);

    // The time the file last changed, null when the file is missing.
    public abstract Instant? lastModified(string path);

    // A new empty file's path.
    public abstract string temporaryFile();

    // The folder temporary files go in.
    public abstract string temporaryDirectory();

    // The full path of each file and folder below the folder, a folder before its contents and each folder's entries
    // in name order, read as a loop reaches them. A link to a folder is given and not followed.
    // null when the folder doesn't exist.
    public abstract Iterable<string>? walk(string directory);
}
