namespace Sharp.IO;

public static class Path
{
    public static string fileName(string path) => global.basename(path);

    public static string directory(string path) => global.dirname(path);

    public static string extension(string path) => global.pathinfo(path, global.PATHINFO_EXTENSION);

    public static string fileNameWithoutExtension(string path) => global.pathinfo(path, global.PATHINFO_FILENAME);
}
