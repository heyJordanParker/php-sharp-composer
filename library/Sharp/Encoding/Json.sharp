namespace Sharp.Encoding;

import Sharp.Internal;
import Sharp.Internal.EncodedAsJson;
import Sharp.Internal.ParsesTypeArgument;

extern Internal.jsonEncode uses none;
extern Internal.jsonDecode uses none;

public static class Json
{
    // The value JSON text holds, an object as a `Map`, which compares by structure. It throws `JsonException` on text
    // that is no JSON.
    public static JsonValue parse(string json) => new JsonValue(Json.read(json));

    // The value of type `T` that JSON text holds, any type a field `parse` reads can hold, as `List<Payment>`: each
    // struct, class, family and enum case in it built as a field of `T` reads it. It throws one `InvalidFields` that
    // lists every bad part (spec section 10). A number or a bool must be one in the JSON, so `"2"` is no `int`.
    [ParsesTypeArgument]
    public static T decode<T>(string json) => Internal.parseAs(typeof(T), Json.read(json), false);

    // JSON text of the value. By default `/` stays `/`, each character outside ASCII stays itself and `1.0` stays
    // `1.0`. `escapeSlashes` writes `/` as `\/`, `escapeUnicode` writes each character outside ASCII as `\u` and its
    // code, and `keepZeroFraction: false` writes `1.0` as `1`, so a payload matches the bytes another system signs:
    // all three give PHP's `json_encode` default.
    // The text is one line. An `indent` above 0 writes each nested value on its own line, `indent` spaces deeper than
    // its parent, with `": "` after a key and `[]` and `{}` for an empty value, so `indent: 4` writes PHP's
    // `JSON_PRETTY_PRINT`. A negative `indent` throws `ValueError`. By default `escapeHtml` writes `<`, `>`, `&`, `'`
    // and `"` inside a string as `<`, `>`, `&`, `'` and `"`, so JSON put inside a `<script>`
    // can't close it. `escapeHtml: false` writes them as themselves, `"` as `\"`.
    public static string encode(
        [EncodedAsJson] Any? value,
        bool escapeSlashes = false,
        bool escapeUnicode = false,
        bool keepZeroFraction = true,
        int indent = 0,
        bool escapeHtml = true
    )
    {
        if (indent < 0) {
            throw new ValueError(`Json.encode: indent is ${indent}, and it must be 0 or more`);
        }

        return Internal.jsonEncode(
            value,
            (escapeSlashes ? 0 : global.JSON_UNESCAPED_SLASHES)
                | (escapeUnicode ? 0 : global.JSON_UNESCAPED_UNICODE)
                | (keepZeroFraction ? global.JSON_PRESERVE_ZERO_FRACTION : 0)
                | (escapeHtml
                    ? global.JSON_HEX_TAG | global.JSON_HEX_AMP | global.JSON_HEX_APOS | global.JSON_HEX_QUOT
                    : 0),
            indent
        );
    }

    // An empty object reads as an empty `Map` and an empty array as an empty `List`, which `encode` writes back as
    // `{}` and `[]`.
    private static Any? read(string json) => Internal.jsonDecode(json);
}
