namespace Sharp.Encoding;

public static class Compression
{
    public static Bytes compress(Bytes data)
        => global.gzcompress(data.data) is string compressed ? Bytes.held(compressed) : throw new ValueError("Compression.compress: zlib could not compress the data");

    public static Bytes uncompress(Bytes data)
        => global.gzuncompress(data.data) is string uncompressed ? Bytes.held(uncompressed) : throw new ValueError("Compression.uncompress: the data is not zlib-compressed");
}
