namespace Sharp;

import ReflectionClass;
import ReflectionFunction;
import ReflectionProperty;
import Sharp.Internal;
import Sharp.Internal.CreatesAttributes;

extern Internal.methods uses none;
extern Internal.properties uses none;
extern Internal.constructor uses none;
extern Internal.hiddenMethod uses none;
extern Internal.createInstance uses any;
extern Internal.typeArguments uses none;
extern Internal.typeKind uses none;
extern Internal.isNullable uses none;
extern Internal.nonNullable uses none;
extern Internal.typeParts uses none;
extern Internal.tupleNames uses none;
extern Internal.genericDefinition uses none;
extern Internal.typeParameters uses none;
extern Internal.baseType uses none;
extern Internal.interfaces uses none;
extern Internal.classFacts uses none;
extern Internal.enumBackingType uses none;
extern Internal.enumCases uses none;
extern Internal.attributes uses any;
extern Internal.attributeData uses none;
extern Internal.constants uses none;
extern Internal.makeGenericType uses none;
extern Internal.isAssignable uses none;
extern Internal.withTag uses none;
extern Internal.tag uses none;
extern Internal.parseAs uses any;
extern Internal.storedValue uses none;

public static class ClassMembers
{
    // The engine gives a type as the text `typeof` gives it, which is its class value, spec section 25.
    private static Class<Any?> classValue(string text)
        => text as Class<Any?> ?? throw new ValueError("The engine gave a type text that names no type.");

    // The engine gives the class that declares a member by its name.
    private static Class<Object> declaringClass(string name)
        => name as Class<Object> ?? throw new ValueError("The engine gave a class name that names no class.");

    // The engine gives a member's visibility as the access modifier that declares it, spec section 5.
    private static Visibility visibility(string modifier) => match (modifier)
    {
        "public" => Visibility.Public,
        "internal" => Visibility.Internal,
        "protected" => Visibility.Protected,
        "private" => Visibility.Private,
        default => throw new ValueError("The engine gave a visibility that is no access modifier."),
    };

    // The words the engine gives of a member's modifiers, each after a space.
    private static List<string> words(string text) => global.explode(" ", text);

    // The parameters of a method or a constructor as the engine gives them, after the row of the method itself: each
    // parameter's name, type, "optional" or "", "variadic" or "" and "constant" or "", in order, "constant" for a
    // default that runs no code.
    private static List<Parameter> parameters(List<List<string>> rows)
    {
        List<Parameter> parameters = [];
        for (const parameter of rows.slice(1)) {
            parameters.add(new Parameter(
                ClassMembers.declaringClass(rows[0][0]),
                rows[0][1],
                parameters.count(),
                parameter[0],
                ClassMembers.classValue(parameter[1]),
                parameter[2] == "optional",
                parameter[3] == "variadic",
                parameter[4] == "constant"
            ));
        }

        return parameters;
    }

    // A method of `readOn` as the engine gives it: first the class that declares it, its name, its result type, its
    // modifier words, each after a space, and its access modifier, then its parameters. `Property.getter()` and
    // `Property.setter()` read a property's accessors through it.
    internal static Method method(Class<Any?> readOn, List<List<string>> rows)
    {
        const words = ClassMembers.words(rows[0][3]);

        return new Method(
            readOn,
            ClassMembers.declaringClass(rows[0][0]),
            rows[0][1],
            words.contains("static"),
            words.contains("virtual"),
            words.contains("abstract"),
            words.contains("override"),
            ClassMembers.visibility(rows[0][4]),
            ClassMembers.classValue(rows[0][2]),
            ClassMembers.parameters(rows)
        );
    }

    // A property or a field of `readOn` as the engine gives it: the class that declares it, its name, its type, its
    // access modifier and its words, each after a space: what writes it, "set" or "init" and the access modifier that
    // reaches it, none for a get-only property, then its modifiers, and last "field" for a field and "plain" for a plain
    // PHP property.
    private static Property property(Class<Any?> readOn, List<string> declared)
    {
        const words = ClassMembers.words(declared[4]);
        const writer = words.indexOfFirst(word => word == "set" || word == "init");

        return new Property(
            readOn,
            ClassMembers.declaringClass(declared[0]),
            declared[1],
            ClassMembers.visibility(declared[3]),
            ClassMembers.classValue(declared[2]),
            writer == null ? null : ClassMembers.visibility(words[writer + 1]),
            words.contains("init"),
            words.contains("static"),
            words.contains("extern"),
            words.contains("virtual"),
            words.contains("abstract"),
            words.contains("override")
        );
    }

    // Whether a member `readOn` gives as `property` reads it is a field.
    private static bool isField(List<string> declared) => ClassMembers.words(declared[4]).contains("field");

    // Whether a member `readOn` gives as `property` reads it is storage a `Field` reads, spec section 25: a field, an
    // auto-property that is neither `virtual` nor `abstract`, spec section 6.1, or a plain PHP property that declares no
    // hook, whatever a subclass may do, since a `Field` refuses a receiver whose class gives it one. None runs an
    // accessor. An `extern` property holds no value, spec section 14.3.
    private static bool isStorage(Class<Any?> readOn, List<string> declared)
    {
        if (ClassMembers.isField(declared)) {
            return true;
        }
        const words = ClassMembers.words(declared[4]);
        if (words.contains("extern")) {
            return false;
        }
        const accessors = Internal.accessors(readOn, declared[1]);

        return (words.contains("plain") || !words.contains("virtual"))
            && !words.contains("abstract")
            && accessors[0] == null
            && accessors[1] == null;
    }

    // The storage of a member as the engine gives it, see `property`.
    private static Field field(List<string> declared)
        => new Field(
            ClassMembers.declaringClass(declared[0]),
            declared[1],
            ClassMembers.visibility(declared[3]),
            ClassMembers.classValue(declared[2]),
            ClassMembers.words(declared[4]).contains("static")
        );

    // Whether the property or field `name` that `declaring` declares holds a value on `receiver`, as PHP's
    // `ReflectionProperty::isInitialized` reads it: false for a `late` one no code has set. A computed property always
    // holds one, and so does one with no storage, as an `extern` property, whose read is what `__get` gives. There is no
    // reset, since a `late` member is set once.
    internal static bool isInitialized(Class<Object> declaring, string name, Object receiver)
        => ClassMembers.stored(declaring, name)?.isInitialized(receiver) ?? true;

    // Whether the declaration of the property or field `name` that `declaring` declares gives it an initial value,
    // constant or not.
    internal static bool hasDefaultValue(Class<Object> declaring, string name)
        => Internal.hiddenMethod(declaring, name + "#initial") != null
            || (ClassMembers.stored(declaring, name) is ReflectionProperty property && property.hasDefaultValue());

    // The initial value the declaration of the property or field `name` that `declaring` declares gives it, as
    // `hasDefaultValue` reads it. One that is not constant runs on each read, as `Parameter.defaultValue()` runs a
    // default that is not constant, so `= new Draft()` gives a new Draft each time. A member with none throws
    // `OutOfRangeException`, as `Parameter.defaultValue()` does.
    internal static Any? defaultValue(Class<Object> declaring, string name)
    {
        const initial = Internal.hiddenMethod(declaring, name + "#initial");
        if (initial != null) {
            return new ReflectionFunction(initial).invoke();
        }
        if (ClassMembers.stored(declaring, name) is ReflectionProperty property && property.hasDefaultValue()) {
            return property.getDefaultValue();
        }

        throw new OutOfRangeException("`defaultValue` reads a property that has a default, and `" + name + "` has none.");
    }

    // The attributes of the property or field `name` that `declaring` declares of the class `TAttribute` or of a class
    // that extends or implements it, as `Class<T>.attributes()` gives a class's. An `extern` property's are those of its
    // hidden static `name#extern`, since PHP declares no property of its name, spec section 14.3.
    internal static List<TAttribute> memberAttributes<TAttribute : Object>(Class<Object> declaring, string name)
        => Internal.attributes(declaring, "property", name, 0, typeof(TAttribute));

    // The attributes `memberAttributes<TAttribute>()` gives, each as written, building none, spec section 25.
    internal static List<AttributeData> memberAttributeData<TAttribute : Object>(Class<Object> declaring, string name)
        => Internal.attributeData(declaring, "property", name, 0, typeof(TAttribute), typeof(AttributeData));

    // PHP's reflection of the storage of the property or field `name` that `declaring` declares, or null for a static
    // whose class keeps none, as a computed one, see `properties()`.
    private static ReflectionProperty? stored(Class<Object> declaring, string name)
        => new ReflectionClass(declaring).hasProperty(name) ? new ReflectionProperty(declaring, name) : null;

    // The one value a member of `type` gives for a type of the kind `kind`, its first part, or OutOfRangeException with
    // `message`, as `List.first()` throws when nothing matches.
    private static Class<Any?> part(Class<Any?> type, TypeKind kind, string message)
        => type.kind() == kind
            ? ClassMembers.classValue(Internal.typeParts(type)[0])
            : throw new OutOfRangeException(message + " " + type.name() + " is none.");

    // The class values of the plain PHP traits the class or trait `type` uses, each followed by the traits it uses in
    // turn.
    private static List<Class<Object>> usedTraits(Class<Object> type)
    {
        const used = global.class_uses(type);
        if (used == false) {
            throw new ValueError("The engine gave a class name that names no class.");
        }

        return global.array_values(used).flatMap(trait => [trait, ...ClassMembers.usedTraits(trait)]);
    }

    // `type` when it is a `Class<Object>`, the class value of a class, an interface or an enum, spec section 25, and null
    // for the class value of a type that is no class, as the root bound `Object`, `int` or `List<int>`, which PHP declares
    // no class for. Each member that hands a class value to PHP's reflection reads it through this, so such a type has no
    // members, and filters no attributes.
    internal static Class<T>? declared<T>(Class<T> type) => type is Class<Object> ? type : null;

    // The members of the class value of any type, a class's and `int`'s alike, which take the type apart, spec section 25.
    // A member of one kind of type gives `[]` for a type of any other kind, or throws `OutOfRangeException` where it
    // gives one value. Each reads the type without its `?`, but `isNullable()` and `nonNullable()`.
    extension(Class<Any?> type)
    {
        // The type's full name as PHP# writes it, spec section 25: `App.Orders.Counted`, and `List<string>` for a type
        // that is no class. A class value holds a class's name as PHP writes it, `App\Orders\Counted`. A type parameter's
        // is its name, `TItem`. `typeof(List)`, `typeof(Map)` and `typeof(Set)` hold the engine's class of the
        // collection, and their names are the collection's, as `List` for `List<int>`'s `genericDefinition()`.
        public string name()
            => type == typeof(List) ? "List"
                : type == typeof(Map) ? "Map"
                : type == typeof(Set) ? "Set"
                : global.str_replace("\\", ".", type);

        public TypeKind kind() => match (Internal.typeKind(type))
        {
            "Named" => TypeKind.Named,
            "Union" => TypeKind.Union,
            "Intersection" => TypeKind.Intersection,
            "Tuple" => TypeKind.Tuple,
            "Function" => TypeKind.Function,
            "TypeParameter" => TypeKind.TypeParameter,
            default => throw new ValueError("The engine gave a type kind TypeKind has no case for."),
        };

        // Whether the type takes null: `int?`, `Box<Tone>?` and a union that holds null.
        public bool isNullable() => Internal.isNullable(type);

        // The type without null: `typeof(int)` for `int?`.
        public Class<Any?> nonNullable() => ClassMembers.classValue(Internal.nonNullable(type));

        // The type arguments of a class or a built-in type, each whole: `[typeof(string), typeof(Box<int>?)]` for
        // `Map<string, Box<int>?>`.
        public List<Class<Any?>> typeArguments() => Internal.typeArguments(type).map(ClassMembers.classValue);

        // The generic type without its type arguments: `typeof(List)` for
        // `List<int>`, and null for a type that declares no type parameter.
        public Class<Any?>? genericDefinition()
            => Internal.genericDefinition(type) is string definition ? ClassMembers.classValue(definition) : null;

        // The type parameters a generic type declares, each of the kind TypeParameter: `[TItem]` for `typeof(Crate)`.
        public List<Class<Any?>> typeParameters() => Internal.typeParameters(type).map(ClassMembers.classValue);

        // A type parameter's bound: `Any?` where none is written.
        public Class<Any?> bound() => ClassMembers.part(type, TypeKind.TypeParameter, "`bound` reads a type parameter, and");

        // A union's members. Null is never one, and `isNullable()` holds it.
        public List<Class<Any?>> unionMembers()
            => type.kind() == TypeKind.Union ? Internal.typeParts(type).map(ClassMembers.classValue) : [];

        // An intersection's members, `[typeof(Shippable), typeof(Billable)]` for `Shippable & Billable`.
        public List<Class<Any?>> intersectionMembers()
            => type.kind() == TypeKind.Intersection ? Internal.typeParts(type).map(ClassMembers.classValue) : [];

        // A tuple's elements, each with its name, or null for an element written without one.
        public List<TupleElement> tupleElements()
            => type.kind() != TypeKind.Tuple ? [] : Internal.tupleNames(type).zip(Internal.typeParts(type)).map(
                element => new TupleElement(element[0], ClassMembers.classValue(element[1]))
            );

        // A function type's parameter types.
        public List<Class<Any?>> parameterTypes()
            => type.kind() == TypeKind.Function ? Internal.typeParts(type).slice(1).map(ClassMembers.classValue) : [];

        // A function type's result type.
        public Class<Any?> returnType()
            => ClassMembers.part(type, TypeKind.Function, "`returnType` reads a function type, and");

        // The generic type with `arguments`: `typeof(List).makeGenericType([typeof(Order)])`
        // is `typeof(List<Order>)`. Throws InvalidArgumentException on another count of arguments than the type has
        // type parameters, and on an argument outside its parameter's bound.
        public Class<Any?> makeGenericType(List<Class<Any?>> arguments)
            => ClassMembers.classValue(Internal.makeGenericType(type, arguments));

        // Whether a value of the type fits `other`, as `is` answers it for such a value, spec section 25:
        // `typeof(CardPayment).isAssignableTo(typeof(Payment))` for a class that implements `Payment`, and
        // `typeof(List<int>).isAssignableTo(typeof(Iterable<Any?>))`. Generic types, unions and nullable types included.
        public bool isAssignableTo(Class<Any?> other) => Internal.isAssignable(type, other);
    }

    extension<T>(Class<T> type)
    {
        // The properties of the class, auto-properties, ones with accessors and computed ones, and no field, its own
        // first and then those it inherits, in the order they are declared, at every visibility, its statics included,
        // spec section 25.
        public List<Property> properties()
            => ClassMembers.declared(type) == null
                ? []
                : Internal.properties(type)
                    .filter(declared => !ClassMembers.isField(declared))
                    .map(declared => ClassMembers.property(type, declared));

        // What the class's objects store, as an ORM or a serializer reads it, spec section 25: each field, the storage
        // of each auto-property that is neither `virtual` nor `abstract`, and each plain PHP property that declares no
        // hook, its own first and then those it inherits, in the order they are declared, at every visibility, its
        // statics included.
        public List<Field> fields()
            => ClassMembers.declared(type) == null
                ? []
                : Internal.properties(type)
                    .filter(declared => ClassMembers.isStorage(type, declared))
                    .map(ClassMembers.field);

        // The instance and static methods of the class, its own first and then those it inherits, in the order they
        // are declared, at every visibility, without its constructor, spec section 25.
        public List<Method> methods()
            => ClassMembers.declared(type) == null
                ? []
                : Internal.methods(type).map(rows => ClassMembers.method(type, rows));

        // The class's constructor, its own or the one it inherits, or null for a class that has none.
        public Constructor? constructor()
        {
            if (ClassMembers.declared(type) == null) {
                return null;
            }
            const rows = Internal.constructor(type);

            return rows == null
                ? null
                : new Constructor(
                    ClassMembers.declaringClass(rows[0][0]),
                    ClassMembers.visibility(rows[0][4]),
                    ClassMembers.parameters(rows)
                );
        }

        // A new object of the class, with the class value's type arguments, created by its constructor with
        // `arguments`. The calling code reaches the constructor as a
        // direct `new` would. Throws InvalidArgumentException for an abstract class, an interface or an enum, and for
        // arguments the constructor's parameters don't take. Its arguments are a runtime list, and the class value may
        // hold any subclass, so it may have every effect, as `Property.get` may, spec section 29.
        public T createInstance(List<Any?> arguments) => Internal.createInstance(type, arguments);

        // The variant of the family the class is whose `[Key]` is `tag`, spec section 10, or null for a name it has no
        // variant of, and for a class that is no family. It is pure, so a single-table-inheritance base builds the row's
        // class with `new (typeof(Self).withTag(row.type) ?? throw …)(…)`.
        public Class<T>? withTag(string tag) => Internal.withTag(type, tag) is string variant ? variant as Class<T> : null;

        // The name the family of the class stores for it, spec section 10: its `[Key]`, or its value as a backed
        // machine's case. Null for a class that is no variant of a family. It reads what `withTag` reads, so
        // `typeof(F).withTag(c.tag() ?? …)` is `c` for every variant `c` of `F`.
        public string? tag() => Internal.tag(type);

        // A `T` built from `value`, a stored value already read into lists, maps and scalars, as a field `parse` reads
        // it, spec section 10: the read `Json.parse` makes once it has read the text. An `Err` holds one `ParseError`
        // that lists every bad part. It has the effects of the reader it runs where the checker knows it, and may
        // have every effect where the class value may hold a class whose reader differs, spec section 29.
        public Result<T, ParseError> parse(Any? value)
            => Internal.parseAs(type, value, false) as Result<T, ParseError> ?? throw new LogicException("The engine's parse gave no Result");

        // The stored form of `value` that `decode` reads back, lists, maps and scalars, spec section 10: what
        // `Json.encode` writes as text, each field `parse` reads under its key at any visibility, so a storage layer in
        // another namespace reads a class's `internal` ones. It throws the `JsonException` `Json.encode` throws.
        public Any? encode(T value) => Internal.storedValue(value);

        // The class the class extends, with the type arguments it gives it, or null.
        public Class<Any?>? baseType()
            => ClassMembers.declared(type) != null && Internal.baseType(type) is string base
                ? ClassMembers.classValue(base)
                : null;

        // The interfaces the class implements, its own and those it inherits, each with the type arguments it gives it.
        public List<Class<Any?>> interfaces()
            => ClassMembers.declared(type) == null ? [] : Internal.interfaces(type).map(ClassMembers.classValue);

        // The plain PHP traits the class uses, spec section 22: its own, each followed by the traits it uses, then those
        // of the classes it extends, each once, as `is` tests them.
        public List<Class<Any?>> traits()
            => ClassMembers.declared(type) is Class<Object> declared
                ? [...ClassMembers.usedTraits(declared), ...(type.baseType()?.traits() ?? [])].distinct()
                : [];

        // Whether the class is abstract, an interface included.
        public bool isAbstract() => ClassMembers.declared(type) != null && Internal.classFacts(type)[0];

        public bool isInterface() => ClassMembers.declared(type) != null && Internal.classFacts(type)[1];

        // Whether the class is a struct, spec section 10.
        public bool isStruct() => ClassMembers.declared(type) != null && Internal.classFacts(type)[2];

        public bool isEnum() => ClassMembers.declared(type) != null && Internal.classFacts(type)[3];

        // The type an enum's cases are backed by, `int` or `string`, or null for a pure enum and any other class.
        public Class<Any?>? enumBackingType()
            => ClassMembers.declared(type) != null && Internal.enumBackingType(type) is string backing
                ? ClassMembers.classValue(backing)
                : null;

        // The constants of the class, its own first and then those it inherits, in the order they are declared, at
        // every visibility, without an enum's cases, which `enumCases()` gives, spec section 25. The engine gives each
        // as the class that declares it, its name and its type.
        public List<Constant> constants()
            => ClassMembers.declared(type) == null
                ? []
                : Internal.constants(type).map(
                    declared => new Constant(
                        ClassMembers.declaringClass(declared[0]),
                        declared[1],
                        ClassMembers.classValue(declared[2])
                    )
                );

        // An enum's cases, in the order they are declared.
        public List<EnumCase> enumCases()
            => ClassMembers.declared(type) == null
                ? []
                : Internal.enumCases(type, typeof(EnumCase));

        [CreatesAttributes]
        public List<TAttribute> attributes<TAttribute : Object>()
            => ClassMembers.declared(type) == null ? [] : Internal.attributes(type, "class", "", 0, typeof(TAttribute));

        // The attributes `attributes<TAttribute>()` gives, each as written, building none, spec section 25.
        public List<AttributeData> attributeData<TAttribute : Object>()
            => ClassMembers.declared(type) == null
                ? []
                : Internal.attributeData(type, "class", "", 0, typeof(TAttribute), typeof(AttributeData));
    }
}
