namespace Sharp.System;

// The process's arguments, environment variables, folder and machine. A module binds `SystemEnvironment`, the real
// ones, and a test passes a `Sharp.Testing.FakeEnvironment`.
public effect abstract class Environment
{
    public abstract List<string> arguments { get; }

    public abstract string? variable(string name);

    public abstract Map<string, string> variables();

    // Sets the variable for this process and the programs it starts.
    public abstract void setVariable(string name, string value);

    public abstract string currentDirectory();

    public abstract void changeDirectory(string path);

    public abstract string require(string name);

    // How many processors the machine has online, at least 1.
    public abstract int processorCount();

    // The machine's host name.
    public abstract string machineName();
}
