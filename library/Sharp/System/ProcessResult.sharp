namespace Sharp.System;

// What a program `Process.run` started gave back. A non-zero exit is a value, as .NET's RunAndCaptureText returns it.
public struct ProcessResult
{
    public ProcessResult(public int exitCode { get; }, public string output { get; }, public string errorOutput { get; }) { }

    // Whether the program exited with 0.
    public bool successful => this.exitCode == 0;
}
