namespace Sharp.System;

import Sharp.Time.Duration;

// This process and the programs it starts. A module binds `SystemProcess`, which starts real programs, and a test
// passes a `Sharp.Testing.FakeProcess`.
public effect abstract class Process
{
    // Ends the run with `code` at once, skipping every finally, spec section 27.
    public abstract never exit(ExitCode code);

    // This process's id.
    public abstract int id();

    // Runs `program` with `arguments` and waits for it, with no input. A non-zero exit is a returned value.
    public abstract ProcessResult run(string program, List<string> arguments = [], Duration? timeout = null);

    // Starts `program` with `arguments` and returns while it runs, with its input a pipe the returned `ChildProcess`
    // writes.
    public abstract ChildProcess start(string program, List<string> arguments = []);
}
