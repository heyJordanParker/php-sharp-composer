namespace Sharp.Interop;

import DateTimeImmutable;
import DateTimeInterface;
import DateTimeZone;
import Sharp.Time.DateTime;
import Sharp.Time.Instant;
import Sharp.Time.TimeZone;

// A plain PHP date, such as the Carbon a Laravel model gives, as an `Instant` or a `DateTime`, and an `Instant` as a
// plain PHP date, for a plain PHP library that takes a `DateTimeInterface`. `PhpDateTimes` crosses a `DateTime` back.
// None of them reads the clock.
public static class PhpDates
{
    extension(DateTimeInterface value)
    {
        // The instant, to the microsecond a PHP date holds.
        public Instant toInstant() => new Instant(value.getTimestamp(), Int.parse(value.format("u")) * 1_000);

        // The instant in the value's zone, a fixed offset such as "+03:00" included, but "+00:00", which is UTC. An
        // abbreviation, such as "EEST", has no rules for its clocks, so it throws `ValueError`, except at offset 0.
        public DateTime toDateTime()
        {
            const name = value.getTimezone().getName();
            const isZeroOffset = value.getOffset() == 0 && (global.str_starts_with(name, "+") || global.str_starts_with(name, "-"));
            if (!isZeroOffset && TimeZone.tryOf(name) is TimeZone zone) {
                return new DateTime(value.toInstant(), zone);
            }
            if (value.getOffset() != 0) {
                throw new ValueError(`\`toDateTime\` needs a zone such as "Europe/Sofia" or an offset such as "+03:00", and "${name}" is an abbreviation, not a zone of the time zone database. \`toInstant()\` keeps the instant without a zone.`);
            }

            return new DateTime(value.toInstant(), TimeZone.utc);
        }
    }

    extension(Instant value)
    {
        // A plain PHP date at the same instant, in UTC. A PHP date holds microseconds, so the nanoseconds below them are
        // left out.
        public DateTimeImmutable toPhpDateTime()
            => DateTimeImmutable.createFromTimestamp(value.epochSeconds).setTimezone(new DateTimeZone("UTC")).setMicrosecond(value.nanosecond / 1_000);
    }
}
