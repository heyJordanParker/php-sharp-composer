namespace Sharp.Interop;

// PHP's global variables and superglobals, for plain PHP that keeps its state there, as a legacy page or a WordPress
// plugin does. PHP# has no `global` and no superglobals, so code that reaches them takes this class and has its effect.
// A module binds `SystemPhpGlobals`, PHP's own, and a test passes a `Sharp.Testing.FakePhpGlobals`.
public effect abstract class PhpGlobals
{
    // The global variable `name`, as PHP's `$GLOBALS[name]` reads it, or null when it is not set.
    public abstract Any? get(string name);

    // Sets the global variable `name`, as PHP's `$GLOBALS[name] = value` does.
    public abstract void set(string name, Any? value);

    // The value at `key` of a superglobal, as PHP's `$_SERVER[key]` reads it, or null when it is not set.
    public abstract Any? read(Superglobal which, string key);

    // Sets the value at `key` of a superglobal, as PHP's `$_SERVER[key] = value` does.
    public abstract void write(Superglobal which, string key, Any? value);

    // Runs the PHP file at `path` in the global scope, as a page's own `include` does, so each global variable is in
    // its scope, and each one it sets is a global after it. A file that cannot be read throws `RuntimeException`.
    public abstract void include(string path);
}
