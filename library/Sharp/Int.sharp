namespace Sharp;

public static class Int
{
    public const int MAX = global.PHP_INT_MAX;

    public const int MIN = global.PHP_INT_MIN;

    public static int parse(string text)
    {
        const number = Int.tryParse(text);
        if (number is int) {
            return number;
        }
        if (Int.digits(text) is string) {
            throw new ArithmeticError(`Int.parse: "${text}" is out of range for an int`);
        }
        if (Int.digits(global.trim(text)) is string) {
            throw new ValueError(`Int.parse: "${text}" is not an int: remove its spaces with trim() first`);
        }
        throw new ValueError(`Int.parse: "${text}" is not an int`);
    }

    public static int? tryParse(string text)
    {
        const digits = Int.digits(text);
        return (digits is string) ? global.filter_var(digits, global.FILTER_VALIDATE_INT, global.FILTER_NULL_ON_FAILURE) : null;
    }

    private static string? digits(string text)
    {
        let found = 0;
        const digits = global.preg_replace("/\\A([+-]?)0*([0-9]+)\\z/", "$1$2", text, 1, found);
        return found == 1 ? digits : null;
    }

    extension(int value)
    {
        // The string of the one byte `value`, from 0 to 255, as Kotlin's `Int.toByte()` gives it.
        public string toByteString()
            => value >= 0 && value <= 255 ? global.chr(value) : throw new ValueError("`toByteString` needs a byte from 0 to 255, and the value is outside it.");
    }
}
