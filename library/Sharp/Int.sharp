namespace Sharp;

public static class Int
{
    public const int MAX = global.PHP_INT_MAX;

    public const int MIN = global.PHP_INT_MIN;

    // The int `text` writes in `radix`, from 2 to 36, with the letters a to z, in either case, for the digits past 9,
    // or an `Err` that says why the text writes none. A radix outside 2 to 36 throws ValueError.
    public static Result<int, ParseError> parse(string text, int radix = 10)
    {
        Int.checkRadix(radix, "Int.parse");
        if (Int.read(text, radix) is int number) {
            return Result.Ok(number);
        }
        const base = radix == 10 ? "" : ` in base ${radix}`;
        let problem = `Int.parse: "${text}" is not an int${base}`;
        if (Int.digits(text, radix) is string) {
            problem = `Int.parse: "${text}" is out of range for an int`;
        } else if (Int.digits(global.trim(text), radix) is string) {
            problem = `Int.parse: "${text}" is not an int${base}: remove its spaces with trim() first`;
        }
        return Result.Err(new ParseError(["": problem]));
    }

    // The int `text` writes in `radix`, or null.
    private static int? read(string text, int radix)
    {
        if (Int.digits(text, radix) is not string digits) {
            return null;
        }
        // Read as a negative number, which reaches one further than a positive one, so Int.MIN parses.
        let negated = 0;
        for (const digit of global.str_split(global.ltrim(digits, "+-"))) {
            if (negated.checkedMultiply(radix)?.checkedSubtract(global.intval(digit, 36)) is int next) {
                negated = next;
            } else {
                return null;
            }
        }
        return global.str_starts_with(digits, "-") ? negated : negated.checkedMultiply(-1);
    }

    // The int the 8 bytes write in `order`.
    public static int fromBytes(Bytes bytes, ByteOrder order = ByteOrder.Big)
    {
        if (bytes.length() != 8) {
            throw new ValueError(`Int.fromBytes: an int is 8 bytes, and the bytes hold ${bytes.length()}`);
        }

        return global.unpack(order.value, bytes.data) is [int value] ? value : throw new ValueError("Int.fromBytes: the bytes write no int");
    }

    private static void checkRadix(int radix, string member)
    {
        if (radix < 2 || radix > 36) {
            throw new ValueError(`${member} takes a base from 2 to 36, and ${radix} is not one.`);
        }
    }

    // The sign and the digits of `text` in `radix`, without leading zeros, or null when it writes no int in `radix`.
    private static string? digits(string text, int radix)
    {
        const allowed = radix <= 10 ? `0-${radix - 1}` : `0-9a-${global.chr(86 + radix)}A-${global.chr(54 + radix)}`;
        let found = 0;
        const digits = global.preg_replace(`/\\A([+-]?)0*([${allowed}]+)\\z/`, "$1$2", text, 1, found);
        return found == 1 ? digits : null;
    }

    extension(int value)
    {
        public int abs()
            => value == Int.MIN
                ? throw new ArithmeticError("`abs` of the smallest int is larger than the largest int.")
                : global.abs(value);

        public int clamp(int min, int max)
            => min > max
                ? throw new ValueError("`clamp` needs a minimum no larger than its maximum, and the minimum is larger.")
                : value < min ? min : value > max ? max : value;

        // The quotient rounded down: -7.floorDiv(2) is -4.
        public int floorDiv(int divisor)
        {
            const quotient = value / divisor;

            return value % divisor != 0 && (value < 0) != (divisor < 0) ? quotient - 1 : quotient;
        }

        // The remainder with the divisor's sign: -7.mod(2) is 1.
        public int mod(int divisor)
        {
            const remainder = value % divisor;

            return remainder != 0 && (remainder < 0) != (divisor < 0) ? remainder + divisor : remainder;
        }

        public string format(string thousandsSeparator = ",")
        {
            const digits = global.strrev(global.ltrim(global.strval(value), "-"));
            const grouped = global.strrev(global.implode(global.strrev(thousandsSeparator), global.str_split(digits, 3)));
            return value < 0 ? "-" + grouped : grouped;
        }

        public string toHex()
            => value == Int.MIN ? "-8000000000000000" : value < 0 ? "-" + global.dechex(-value) : global.dechex(value);

        // The 8 bytes of `value` in `order`, a negative one in two's complement.
        public Bytes toBytes(ByteOrder order = ByteOrder.Big) => Bytes.held(global.pack(order.value, value));

        // The character of the code point `value`.
        public string toCharacter()
            => global.mb_chr(value, "UTF-8") is string character
                ? character
                : throw new ValueError("`toCharacter` needs a Unicode scalar value, from 0 to 0x10FFFF and no surrogate, and the value is not one.");

        // The sum, or null where it is past Int.MAX or Int.MIN.
        public int? checkedAdd(int other)
            => (other > 0 && value > Int.MAX - other) || (other < 0 && value < Int.MIN - other) ? null : value + other;

        public int? checkedSubtract(int other)
            => (other < 0 && value > Int.MAX + other) || (other > 0 && value < Int.MIN + other) ? null : value - other;

        // Each bound divided by one factor, rounded toward 0, is the furthest the other factor reaches.
        public int? checkedMultiply(int other)
        {
            const overflows = value > 0
                ? (other > 0 ? value > Int.MAX / other : other < Int.MIN / value)
                : (other > 0 ? value < Int.MIN / other : value != 0 && other != 0 && value < Int.MAX / other);

            return overflows ? null : value * other;
        }

        // The sum, or Int.MAX or Int.MIN where it is past them.
        public int saturatingAdd(int other) => value.checkedAdd(other) ?? (other > 0 ? Int.MAX : Int.MIN);

        public int saturatingSubtract(int other) => value.checkedSubtract(other) ?? (other < 0 ? Int.MAX : Int.MIN);

        public int saturatingMultiply(int other) => value.checkedMultiply(other) ?? ((value < 0) == (other < 0) ? Int.MAX : Int.MIN);
    }
}
