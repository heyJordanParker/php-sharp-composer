namespace Sharp;

import Sharp.Internal.CreatesAttributes;
import Sharp.Internal.NamesMember;
import Sharp.Internal.RunsInitialValues;

extern Internal.readField uses none;
extern Internal.writeField uses none;

// The storage of a field a class declares, of an auto-property that is neither `virtual` nor `abstract`, or of a plain
// PHP property that declares no hook, as `Class<T>.fields()` gives it, spec section 25: the class that declares it, its
// name, its visibility, its type as declared and whether it is static. A field is storage, spec section 6, so reading
// and writing one runs no code a project wrote. The engine creates it.
public class Field
{
    internal Field(
        public Class<Object> declaringClass { get; },
        [NamesMember] public string name { get; },
        public Visibility visibility { get; },
        public Class<Any?> type { get; },
        public bool isStatic { get; }
    ) { }

    // Two values are one field when they name it in the class that declares it, so a `Map<Field, V>` keys by the field
    // whenever `fields()` read it.
    public static bool operator ==(Field a, Field b) => a.declaringClass == b.declaringClass && a.name == b.name;

    public int hash() => global.crc32(this.declaringClass.name() + "::$" + this.name);

    // The value the storage holds on `receiver`, and a static's, which takes null. The calling code reaches it as a
    // direct read of the field or the property would. It runs no accessor, so a read is pure, spec section 29: a
    // receiver whose class gives the property an accessor, as a PHP 8.4 subclass may by declaring it again, and a static
    // whose class's initial values have not run throw Error rather than run that code. An instance field given null
    // throws InvalidArgumentException.
    public Any? get(Object? receiver) => Internal.readField(receiver, this.declaringClass, this.name);

    // Writes `value` into the storage on `receiver`, or into a static's, which takes null. The calling code reaches it
    // as a direct write of the field, or the property's `set` or `init`, would, and `value` is checked against its type
    // there. An `init` property's storage takes a write only while it holds no value. It runs no accessor, so a write
    // is pure, and it throws Error where `get` does.
    public void set(Object? receiver, Any? value) => Internal.writeField(receiver, this.declaringClass, this.name, value);

    // Whether the storage holds a value on `receiver`, as `Property.isInitialized` reads it.
    public bool isInitialized(Object receiver) => ClassMembers.isInitialized(this.declaringClass, this.name, receiver);

    // Whether the declaration gives the storage an initial value, as `Property.hasDefaultValue` reads it.
    public bool hasDefaultValue => ClassMembers.hasDefaultValue(this.declaringClass, this.name);

    // The initial value the declaration gives the storage, as `Property.defaultValue()` gives it: one that is not
    // constant runs on each read, so a read has the effects of the initial values it can run, spec section 29.
    [RunsInitialValues]
    public Any? defaultValue() => ClassMembers.defaultValue(this.declaringClass, this.name);

    // The attributes of the field, or of its property, of the class `TAttribute` or of a class that extends or
    // implements it, as `Class<T>.attributes()` gives a class's.
    [CreatesAttributes]
    public List<TAttribute> attributes<TAttribute : Object>()
        => ClassMembers.memberAttributes<TAttribute>(this.declaringClass, this.name);

    // The attributes `attributes<TAttribute>()` gives, each as written, building none, spec section 25.
    public List<AttributeData> attributeData<TAttribute : Object>()
        => ClassMembers.memberAttributeData<TAttribute>(this.declaringClass, this.name);
}
