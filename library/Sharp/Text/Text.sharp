namespace Sharp.Text;

import ValueError;

extern strtolower;
extern strtoupper;
extern ucfirst;

public static class Text
{
    public static extern string slug(string title);

    [Replaces("chr")]
    public static string fromByte(int byte)
        => byte >= 0 && byte <= 255 ? chr(byte) : throw new ValueError("Text.fromByte: the value is not a byte from 0 to 255");
}
