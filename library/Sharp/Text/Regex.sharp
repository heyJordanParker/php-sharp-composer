namespace Sharp.Text;

import Sharp.Internal;

extern Internal.silencedWarning uses none;

public struct Regex
{
    private Regex(private string pattern { get; }) { }

    // A pattern that does not compile throws `ValueError` with PHP's reason, as "No ending matching delimiter ')'
    // found".
    public static Regex parse(string pattern)
        => Regex.tryParse(pattern) ?? throw new ValueError(`Regex.parse: "${pattern}" does not compile: ${Regex.compileError()}`);

    // A pattern that does not compile gives null, and PHP's warning for it reaches no error handler.
    public static Regex? tryParse(string pattern) => global.preg_match(pattern, "") is int ? new Regex(pattern) : null;

    // PHP's reason for the pattern `tryParse` could not compile, from the warning its `preg_match` raised.
    private static string compileError() => (Internal.silencedWarning() ?? "").removePrefix("preg_match(): ");

    public bool matches(string text)
    {
        const found = global.preg_match(this.pattern, text);
        return found is int count ? count == 1 : throw Regex.lastError("matches");
    }

    public Map<int|string, string>? match(string text)
    {
        Map<int|string, string> groups = [:];
        const found = global.preg_match(this.pattern, text, groups);
        return found is int count ? (count == 1 ? groups : null) : throw Regex.lastError("match");
    }

    public List<Map<int|string, string>> matchAll(string text)
    {
        List<Map<int|string, string>> sets = [];
        const found = global.preg_match_all(this.pattern, text, sets, global.PREG_SET_ORDER);
        return (found is int) ? sets : throw Regex.lastError("matchAll");
    }

    public string replace(string replacement, string text)
        => global.preg_replace(this.pattern, replacement, text) ?? throw Regex.lastError("replace");

    public List<string> split(string text)
    {
        const parts = global.preg_split(this.pattern, text);
        return (parts is bool) ? throw Regex.lastError("split") : parts;
    }

    public List<string> filter(List<string> texts)
    {
        const kept = global.preg_grep(this.pattern, texts);
        return (kept is bool) ? throw Regex.lastError("filter") : global.array_values(kept);
    }

    public static string escape(string text) => global.preg_quote(text, "/");

    private static ValueError lastError(string method) => new ValueError(`Regex.${method}: the pattern failed: ${global.preg_last_error_msg()}`);
}
