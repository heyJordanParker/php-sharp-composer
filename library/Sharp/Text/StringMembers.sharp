namespace Sharp.Text;

public static class StringMembers
{
    private static extern string slugOf(string title);

    // `text` with each character folded by Unicode's simple case folding where `ignoreCase` is true, which keeps its
    // length, or `text` itself.
    private static string folded(string text, bool ignoreCase)
        => ignoreCase ? global.mb_convert_case(text, global.MB_CASE_FOLD_SIMPLE, "UTF-8") : text;

    // Whether `text` holds a character and each is in `characterClass`, the inside of a regular expression's brackets,
    // or ValueError naming `member` for text that is not UTF-8.
    private static bool isEach(string text, string characterClass, string member)
        => global.preg_match(`/\\A[${characterClass}]+\\z/u`, text) is int found
            ? found == 1
            : throw new ValueError(`\`${member}\` reads UTF-8 text, and the text is not.`);

    extension(string text)
    {
        public string slug() => StringMembers.slugOf(text);

        public int length() => global.mb_strlen(text, "UTF-8");

        public string substring(int start, int? end = null)
        {
            const stop = end ?? text.length();
            if (start < 0 || stop < start || stop > text.length()) {
                throw new OutOfRangeException("`substring` takes a range inside the text, and the range is outside it.");
            }
            return global.mb_substr(text, start, stop - start, "UTF-8");
        }

        // Each member that takes `ignoreCase` compares the two texts with each character folded by Unicode's simple case
        // folding, as Kotlin's `ignoreCase = true` and .NET's `OrdinalIgnoreCase` compare one character at a time, so a
        // folded text keeps its length and an index into it is an index into the text.
        public int? indexOf(string other, int from = 0, bool ignoreCase = false)
            => from < 0 || from > text.length()
                ? throw new OutOfRangeException("`indexOf` starts inside the text, and the start is outside it.")
                : global.mb_strpos(StringMembers.folded(text, ignoreCase), StringMembers.folded(other, ignoreCase), from, "UTF-8") is int index ? index : null;

        public int? lastIndexOf(string other, bool ignoreCase = false)
            => global.mb_strrpos(StringMembers.folded(text, ignoreCase), StringMembers.folded(other, ignoreCase), 0, "UTF-8") is int index ? index : null;

        // These three branch on the flag, so a call without it runs PHP's function alone.
        public bool contains(string other, bool ignoreCase = false)
            => ignoreCase
                ? global.str_contains(global.mb_convert_case(text, global.MB_CASE_FOLD_SIMPLE, "UTF-8"), global.mb_convert_case(other, global.MB_CASE_FOLD_SIMPLE, "UTF-8"))
                : global.str_contains(text, other);

        public bool startsWith(string prefix, bool ignoreCase = false)
            => ignoreCase
                ? global.str_starts_with(global.mb_convert_case(text, global.MB_CASE_FOLD_SIMPLE, "UTF-8"), global.mb_convert_case(prefix, global.MB_CASE_FOLD_SIMPLE, "UTF-8"))
                : global.str_starts_with(text, prefix);

        public bool endsWith(string suffix, bool ignoreCase = false)
            => ignoreCase
                ? global.str_ends_with(global.mb_convert_case(text, global.MB_CASE_FOLD_SIMPLE, "UTF-8"), global.mb_convert_case(suffix, global.MB_CASE_FOLD_SIMPLE, "UTF-8"))
                : global.str_ends_with(text, suffix);

        // -1, 0 or 1 in byte order, the order `<` puts strings in, so "10" is before "9" and "Zebra" before "apple".
        public int compareTo(string other, bool ignoreCase = false)
            => StringMembers.folded(text, ignoreCase) <=> StringMembers.folded(other, ignoreCase);

        public bool equals(string other, bool ignoreCase = false)
            => StringMembers.folded(text, ignoreCase) == StringMembers.folded(other, ignoreCase);

        // Each word with its first letter in title case and the rest in lowercase, as .NET's TextInfo.ToTitleCase.
        public string titlecase() => global.mb_convert_case(text, global.MB_CASE_TITLE, "UTF-8");

        // Whitespace, or each character of `characters`, removed from both ends, as Kotlin's `trim(vararg chars)`.
        public string trim(string? characters = null) => global.mb_trim(text, characters);

        public string trimStart(string? characters = null) => global.mb_ltrim(text, characters);

        public string trimEnd(string? characters = null) => global.mb_rtrim(text, characters);

        public string removePrefix(string prefix) => global.str_starts_with(text, prefix) ? global.substr(text, global.strlen(prefix)) : text;

        public string removeSuffix(string suffix)
            => suffix != "" && global.str_ends_with(text, suffix) ? global.substr(text, 0, -global.strlen(suffix)) : text;

        public string padStart(int length, string padding = " ")
            => padding == ""
                ? throw new ValueError("`padStart` needs text to pad with, and it is empty.")
                : global.mb_str_pad(text, length, padding, global.STR_PAD_LEFT, "UTF-8");

        public string padEnd(int length, string padding = " ")
            => padding == ""
                ? throw new ValueError("`padEnd` needs text to pad with, and it is empty.")
                : global.mb_str_pad(text, length, padding, global.STR_PAD_RIGHT, "UTF-8");

        public string lowercase() => global.mb_strtolower(text, "UTF-8");

        public string uppercase() => global.mb_strtoupper(text, "UTF-8");

        public string capitalized() => global.mb_ucfirst(text, "UTF-8");

        public string decapitalized() => global.mb_lcfirst(text, "UTF-8");

        public string repeat(int times)
            => times < 0
                ? throw new ValueError("`repeat` takes a count of 0 or more, and it is negative.")
                : global.str_repeat(text, times);

        // Every occurrence, or the first `limit` of them, as Rust's replacen.
        public string replace(string old, string @new, int? limit = null)
        {
            if (old == "") {
                throw new ValueError("`replace` needs text to replace, and it is empty.");
            }
            if (limit is int count) {
                return count < 0
                    ? throw new ValueError("`replace` takes a limit of 0 or more, and it is negative.")
                    : global.implode(@new, global.explode(old, text, count == global.PHP_INT_MAX ? count : count + 1));
            }
            return global.str_replace(old, @new, text);
        }

        // A limit of 0 gives every part, and a positive one at most that many, the last holding the rest, as Kotlin's.
        public List<string> split(string delimiter, int limit = 0)
            => delimiter == ""
                ? throw new ValueError("`split` needs a delimiter, and it is empty.")
                : limit < 0
                    ? throw new ValueError("`split` takes a limit of 0 or more, and it is negative.")
                    : global.explode(delimiter, text, limit == 0 ? global.PHP_INT_MAX : limit);

        public List<string> lines() => global.preg_split("/\\r\\n|\\n|\\r/", text) as List<string> ?? [text];

        public List<string> characters() => global.mb_str_split(text, 1, "UTF-8");

        public List<int> codePoints()
            => text.characters().map(
                (string character) => global.mb_ord(character, "UTF-8") as int ?? throw new ValueError("`codePoints` reads UTF-8 text, and the text is not."));

        // The text read as its bytes, spec section 18, as `length()`, `substring()` and `codePoints()` read it as
        // characters: binary data, as `Ip.toBinary` gives, and the bytes another system counts or signs.
        public int byteLength() => global.strlen(text);

        public string byteSubstring(int start, int? end = null)
        {
            const stop = end ?? text.byteLength();
            if (start < 0 || stop < start || stop > text.byteLength()) {
                throw new OutOfRangeException("`byteSubstring` takes a range inside the bytes, and the range is outside it.");
            }
            return global.substr(text, start, stop - start);
        }

        // Each byte as an `int` from 0 to 255.
        public List<int> bytes() => global.str_split(text).map((string byte) => global.ord(byte));

        // PHP reads a blank line as `[null]`, the one row whose field is no string.
        public List<string> parseCsv() => global.str_getcsv(text, ",", "\"", "") as List<string> ?? [""];

        // Each character class member is true when the text holds a character and every character is in the class, as
        // Kotlin's and Rust's `char` members test one, so `"".isLetter()` is false.
        public bool isLetter() => StringMembers.isEach(text, "\\p{L}", "isLetter");

        public bool isDigit() => StringMembers.isEach(text, "\\p{Nd}", "isDigit");

        public bool isLetterOrDigit() => StringMembers.isEach(text, "\\p{L}\\p{Nd}", "isLetterOrDigit");

        // A separator or a control character Kotlin's `isWhitespace` takes, as a tab or a line break.
        public bool isWhitespace() => StringMembers.isEach(text, "\\p{Z}\\t\\n\\x{0B}\\f\\r\\x{1C}-\\x{1F}", "isWhitespace");

        public bool isUppercase() => StringMembers.isEach(text, "\\p{Lu}", "isUppercase");

        public bool isLowercase() => StringMembers.isEach(text, "\\p{Ll}", "isLowercase");

        // The text in a Unicode normalization form, C by default, as .NET's Normalize.
        public string normalized(NormalizationForm form = NormalizationForm.C)
            => global.normalizer_normalize(text, form.value) is string normalized
                ? normalized
                : throw new ValueError("`normalized` reads UTF-8 text, and the text is not.");
    }

    extension(List<string> parts)
    {
        public string join(string separator) => global.implode(separator, parts);
    }
}
