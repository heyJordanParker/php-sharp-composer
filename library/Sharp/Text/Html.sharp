namespace Sharp.Text;

public static class Html
{
    public static string escape(string text) => global.htmlspecialchars(text);

    public static string unescape(string text) => global.htmlspecialchars_decode(text);

    public static string decodeEntities(string text) => global.html_entity_decode(text);

    public static string stripTags(string text) => global.strip_tags(text);
}
