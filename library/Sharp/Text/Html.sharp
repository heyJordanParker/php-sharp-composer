namespace Sharp.Text;

public static class Html
{
    [Replaces("htmlspecialchars")]
    public static string escape(string text) => htmlspecialchars(text);

    [Replaces("htmlspecialchars_decode")]
    public static string unescape(string text) => htmlspecialchars_decode(text);

    [Replaces("html_entity_decode")]
    public static string decodeEntities(string text) => html_entity_decode(text);

    [Replaces("strip_tags")]
    public static string stripTags(string text) => strip_tags(text);
}
