namespace Sharp;

import Sharp.Internal.CreatesAttributes;

extern Internal.accessors;

// A property a class declares, as `Class<T>.properties()` gives it, spec section 25: the class that declares
// it, its name, its visibility, its type as declared, the visibility that reaches its `set` or `init`, null for a
// get-only one, whether it has an `init`, and its modifiers. A property is virtual when a subclass may replace it, as
// `Method.isVirtual` says. The engine creates it, for the class value it was read from.
public class Property
{
    internal Property(
        private Class<Any?> readOn,
        public Class<Object> declaringClass { get; },
        public string name { get; },
        public Visibility visibility { get; },
        public Class<Any?> type { get; },
        public Visibility? setVisibility { get; },
        public bool isInitOnly { get; },
        public bool isStatic { get; },
        public bool isVirtual { get; },
        public bool isAbstract { get; },
        public bool isOverride { get; }
    ) { }

    // Two values are one property when they name it in the class that declares it, so a `Map<Property, V>` keys by the
    // property whenever `properties()` read it.
    public static bool operator ==(Property a, Property b) => a.declaringClass == b.declaringClass && a.name == b.name;

    public int hash() => global.crc32(this.declaringClass.name() + "::$" + this.name);

    // The property's value on `receiver`, and a static's, which takes null. The calling code reaches the property as a
    // direct read would. A computed property runs its `get`, whose body may have any effect (spec section 6.1), so the
    // read may have every effect, spec section 29. An instance property given null throws InvalidArgumentException.
    public Any? get(Object? receiver) => Internal.read(receiver, this.declaringClass, this.name);

    // Writes `value` into the property on `receiver`, or into a static, which takes null. The calling code reaches the
    // property as a direct write would, a get-only one included, and `value` is checked against the property's type
    // there. A `set` may run any code, so the write may have every effect, spec section 29.
    public void set(Object? receiver, Any? value) => Internal.write(receiver, this.declaringClass, this.name, value);

    // Whether the property holds a value on `receiver`, as `ClassMembers.isInitialized` reads it: false for a `late`
    // property no code has set, and for one of a lazy object that has not loaded, which the read does not load.
    public bool isInitialized(Object receiver) => ClassMembers.isInitialized(this.declaringClass, this.name, receiver);

    // The `get` accessor of a property that runs one, as PHP's `ReflectionProperty::getHook` gives it, named
    // `$name::get` as PHP names a property hook, or null for a plain stored property, which is how code tells a property
    // with accessors apart. Its `invoke` reads the property, as `get` does.
    public Method? getter() => this.accessor(0);

    // The `set` accessor of a property that runs one, named `$name::set`, or null. Its `invoke` writes its one argument
    // into the property, as `set` does.
    public Method? setter() => this.accessor(1);

    private Method? accessor(int which)
        => Internal.accessors(this.readOn, this.name)[which] is List<List<string>> rows
            ? ClassMembers.method(this.readOn, rows)
            : null;

    // Writes `value` into the property on `receiver`, a lazy object `createLazy` made, without loading it, so a read of
    // the property never loads it either, as PHP 8.4's `setRawValueWithoutLazyInitialization` writes, and as Doctrine
    // gives a ghost its identifier before it loads. The calling code reaches the property as a direct write would, as
    // `set` does, its `set` accessor included. On an object that is not lazy, or one already loaded, it writes as `set`
    // does.
    public void setBeforeLoad(Object receiver, Any? value)
        => Internal.write(receiver, this.declaringClass, this.name, value, true);

    // Whether the declaration gives the property an initial value, constant or not, as `ClassMembers.hasDefaultValue`
    // reads it.
    public bool hasDefaultValue => ClassMembers.hasDefaultValue(this.declaringClass, this.name);

    // The initial value the declaration gives the property, as `ClassMembers.defaultValue` gives it: one that is not
    // constant runs on each read, so `= new Draft()` gives a new Draft each time, and a property with none throws
    // `OutOfRangeException`.
    public Any? defaultValue() => ClassMembers.defaultValue(this.declaringClass, this.name);

    // The attributes of the property of the class `TAttribute` or of a class that extends or implements it, as
    // `Class<T>.attributes()` gives a class's.
    [CreatesAttributes]
    public List<TAttribute> attributes<TAttribute : Object>()
        => ClassMembers.memberAttributes<TAttribute>(this.declaringClass, this.name);
}
